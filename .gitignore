# ============================================
# KNI Super App - Consolidated .gitignore
# For Web (Next.js) + Mobile Apps (React Native)
# ============================================

# ============================================
# COMMON - All Projects
# ============================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Environment Variables
.env*

# Testing
/coverage

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# WEB APP (Next.js) - KNI-Super-App
# ============================================

# Next.js
/.next/
/out/
next-env.d.ts

# Production
/build

# TypeScript
*.tsbuildinfo

# Vercel
.vercel

# Uploaded files (local storage)
/public/uploads

# Tesseract.js auto-downloads its language model here at runtime (OCR feature)
/eng.traineddata

# Misc
*.pem

# ============================================
# MOBILE APPS (React Native) - kni-app & ServiceEngineerApp
# ============================================

# iOS/Xcode
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

# Android/IntelliJ
.gradle
local.properties
*.iml
*.hprof
.cxx/
.kotlin/

# Keystore Files (ServiceEngineerApp)
*.keystore
!debug.keystore
release-key.keystore
keystore.properties

# React Native
*.jsbundle
.metro-health-check*

# fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# ============================================
# EDITOR & IDE FILES
# ============================================

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/

# Vim
*.swp
*.swo

# Other Editors
.project
.classpath
.settings/

# ============================================
# TEMPORARY & TEST FILES
# ============================================

# Claude Code temporary files
tmpclaude-*

# Script files
*.bat
*.ps1

# Temporary files
*.tmp
*.temp
*~
*.bak
*.backup
*.cwd

# Test files
test-*.js
test-*.ts
check-*.ts
fix-*.js
wrap-*.js

# Documentation files (generated)
*-COMPLETE.md
*-FIX.md
*-FEATURE.md
*-GUIDE.md
*-SUMMARY.md
IMPLEMENTATION*.md
REQUIREMENTS*.md
TESTING*.md
PHASE-*.md
