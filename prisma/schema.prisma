// ========================================
// O) KHAYABOOK FINANCE LAYER
// ========================================

enum CashbookEntryType {
  CASH_IN
  CASH_OUT
  BANK_IN
  BANK_OUT
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

model CashbookEntry {
  id           String             @id @default(cuid())
  ownerId      String
  restaurantId String
  entryType    CashbookEntryType
  amount       Int                // in paise
  paymentMode  PaymentMode        @default(CASH)
  category     String?            // Optional categorization
  description  String             @db.Text
  referenceNo  String?            // Cheque/transaction reference
  entryDate    DateTime
  createdBy    String             // User who created entry
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([restaurantId])
  @@index([entryType])
  @@index([entryDate])
  @@index([createdBy])
}

enum LedgerEntryType {
  PURCHASE      // Vendor supplied goods/services
  PAYMENT       // Payment made to vendor
  CREDIT_NOTE   // Return or adjustment
  DEBIT_NOTE    // Additional charges
}

model VendorLedger {
  id             String           @id @default(cuid())
  ownerId        String
  restaurantId   String
  vendorName     String           // Party/supplier name
  vendorPhone    String?
  vendorGST      String?
  entryType      LedgerEntryType
  amount         Int              // in paise
  paymentMode    PaymentMode?     // Only for PAYMENT entries
  description    String           @db.Text
  billNumber     String?
  billDate       DateTime?
  dueDate        DateTime?
  referenceNo    String?          // Payment reference
  entryDate      DateTime
  balanceAfter   Int?             // Running balance after this entry (in paise)
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([restaurantId])
  @@index([vendorName])
  @@index([entryType])
  @@index([entryDate])
}

enum StaffType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

model Staff {
  id           String       @id @default(cuid())
  ownerId      String
  restaurantId String
  name         String
  phone        String
  email        String?
  designation  String       // Chef, Waiter, Manager, etc.
  staffType    StaffType    @default(FULL_TIME)
  status       StaffStatus  @default(ACTIVE)
  joiningDate  DateTime
  leavingDate  DateTime?
  monthlySalary Int?        // in paise (for fixed salary)
  dailyWage    Int?         // in paise (for daily wage workers)
  address      String?      @db.Text
  aadharNumber String?
  panNumber    String?
  photoUrl     String?
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant  Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  attendance  StaffAttendance[]
  salaryRecords StaffSalary[]

  @@index([ownerId])
  @@index([restaurantId])
  @@index([status])
  @@index([designation])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  WEEKLY_OFF
  HOLIDAY
}

model StaffAttendance {
  id           String           @id @default(cuid())
  staffId      String
  restaurantId String
  attendanceDate DateTime
  status       AttendanceStatus
  checkInTime  DateTime?
  checkOutTime DateTime?
  workHours    Float?           // Calculated work hours
  notes        String?          @db.Text
  markedBy     String           // User who marked attendance
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([staffId, attendanceDate])
  @@index([staffId])
  @@index([restaurantId])
  @@index([attendanceDate])
  @@index([status])
}

enum SalaryStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

model StaffSalary {
  id              String       @id @default(cuid())
  staffId         String
  restaurantId    String
  month           Int          // 1-12
  year            Int
  basicSalary     Int          // in paise
  allowances      Int          @default(0) // in paise
  deductions      Int          @default(0) // in paise (advances, penalties)
  totalPayable    Int          // in paise (basic + allowances - deductions)
  totalPaid       Int          @default(0) // in paise
  status          SalaryStatus @default(PENDING)
  daysWorked      Int?
  totalDays       Int?
  paymentMode     PaymentMode?
  paymentDate     DateTime?
  referenceNo     String?
  notes           String?      @db.Text
  generatedBy     String       // User who generated salary
  paidBy          String?      // User who marked as paid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([staffId, month, year])
  @@index([staffId])
  @@index([restaurantId])
  @@index([status])
  @@index([month, year])
}

// ========================================
// P) FIREBASE PUSH NOTIFICATIONS
// ========================================

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  deviceId  String?
  platform  String   @default("web")
  isActive  Boolean  @default(true)
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  enablePush         Boolean  @default(true)
  enableEmail        Boolean  @default(true)
  enableInApp        Boolean  @default(true)
  notifyOnPayment    Boolean  @default(true)
  notifyOnBooking    Boolean  @default(true)
  notifyOnEngineer   Boolean  @default(true)
  notifyOnCompletion Boolean  @default(true)
  notifyOnOrder      Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushNotificationLog {
  id             String    @id @default(cuid())
  notificationId String?
  userId         String
  fcmMessageId   String?
  title          String
  body           String
  data           Json?
  status         String
  errorMessage   String?   @db.Text
  sentAt         DateTime  @default(now())
  deliveredAt    DateTime?
  clickedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([notificationId])
  @@index([status])
