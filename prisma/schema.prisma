  @@index([ownerId])
  @@index([restaurantId])
  @@index([equipmentId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

model AMCServiceUse {
  id             String   @id @default(cuid())
  subscriptionId String
  bookingId      String?
  serviceDate    DateTime
  serviceType    String
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  subscription AMCSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  booking      ServiceBooking? @relation(fields: [bookingId], references: [id])

  @@index([subscriptionId])
  @@index([bookingId])
}

// ========================================
