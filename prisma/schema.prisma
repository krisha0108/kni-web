  balanceAfter Int? // Running balance after this entry (in paise)
  createdBy    String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([restaurantId])
  @@index([vendorName])
  @@index([entryType])
  @@index([entryDate])
}

enum StaffType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

model Staff {
  id            String      @id @default(cuid())
  ownerId       String
  restaurantId  String
  name          String
  phone         String
  email         String?
  designation   String // Chef, Waiter, Manager, etc.
  staffType     StaffType   @default(FULL_TIME)
  status        StaffStatus @default(ACTIVE)
  joiningDate   DateTime
  leavingDate   DateTime?
  monthlySalary Int? // in rupees (for fixed salary)
  dailyWage     Int? // in rupees (for daily wage workers)
  address       String?     @db.Text
  aadharNumber  String?
  panNumber     String?
  photoUrl      String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  attendance    StaffAttendance[]
  salaryRecords StaffSalary[]

  @@index([ownerId])
  @@index([restaurantId])
  @@index([status])
  @@index([designation])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  WEEKLY_OFF
  HOLIDAY
}

model StaffAttendance {
  id             String           @id @default(cuid())
  staffId        String
  restaurantId   String
  attendanceDate DateTime
  status         AttendanceStatus
  checkInTime    DateTime?
  checkOutTime   DateTime?
  workHours      Float? // Calculated work hours
  notes          String?          @db.Text
  markedBy       String // User who marked attendance
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([staffId, attendanceDate])
  @@index([staffId])
  @@index([restaurantId])
  @@index([attendanceDate])
  @@index([status])
}

enum SalaryStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

model StaffSalary {
  id           String       @id @default(cuid())
  staffId      String
  restaurantId String
  month        Int // 1-12
  year         Int
  basicSalary  Int // in rupees
  allowances   Int          @default(0) // in rupees
  deductions   Int          @default(0) // in rupees (advances, penalties)
  totalPayable Int // in rupees (basic + allowances - deductions)
  totalPaid    Int          @default(0) // in rupees
  status       SalaryStatus @default(PENDING)
  daysWorked   Int?
  totalDays    Int?
  paymentMode  PaymentMode?
  paymentDate  DateTime?
  referenceNo  String?
  notes        String?      @db.Text
  generatedBy  String // User who generated salary
  paidBy       String? // User who marked as paid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([staffId, month, year])
  @@index([staffId])
  @@index([restaurantId])
  @@index([status])
  @@index([month, year])
}

// ========================================
// P) FIREBASE PUSH NOTIFICATIONS
// ========================================

model DeviceToken {
