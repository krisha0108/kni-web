// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========================================
// ENUMS
// ========================================

enum Role {
  ADMIN
  OWNER
  VENDOR
  ENGINEER
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentProofStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum ServiceBookingStatus {
  DRAFT
  SLOT_SELECTED
  PAYMENT_UPLOADED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  ENGINEER_ASSIGNED
  ACCEPTED_BY_ENGINEER
  REJECTED_BY_ENGINEER
  COMPLETED
  CANCELLED
}

enum EngineerAssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum VendorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorSubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  BLOCKED
}

enum MarketplaceOrderStatus {
  PLACED
  CANCELLED
}

enum CartItemType {
  SERVICE
  PART
}

enum CartStatus {
  DRAFT
  SUBMITTED
  ARCHIVED
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum CoverageType {
  CITY_WIDE
  PINCODE_WISE
}

enum RestaurantRole {
  OWNER
  MANAGER
  ACCOUNTANT
  VIEWER
}

// ========================================
// A) AUTH
// ========================================

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  sessions               Session[]
  ownerProfile           OwnerProfile?
  vendorProfile          VendorProfile?
  vendorCoverage         VendorCoverage?
  engineerProfile        EngineerProfile?
  notifications          Notification[]
  restaurants            Restaurant[]
  categoryRequests       CategoryRequest[]
  carts                  Cart[]
  serviceBookings        ServiceBooking[]
  paymentProofs          PaymentProof[]
  engineerAssignments    EngineerAssignment[]
  vendorProducts         VendorProduct[]
  marketplaceOrders      MarketplaceOrder[]      @relation("OwnerOrders")
  vendorOrders           MarketplaceOrder[]      @relation("VendorOrders")
  auditLogs              AuditLog[]
  payouts                Payout[]
  equipments             Equipment[]
  amcSubscriptions       AMCSubscription[]
  stockMovements         StockMovement[]
  expenses               Expense[]
  deviceTokens           DeviceToken[]
  notificationPreference NotificationPreference?
  pushNotificationLogs   PushNotificationLog[]
  restaurantMemberships  RestaurantMember[]      @relation("RestaurantMember")
  restaurantInvites      RestaurantMember[]      @relation("RestaurantInviter")

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ========================================
// B) PROFILES
// ========================================

model OwnerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorProfile {
  id                 String                    @id @default(cuid())
  userId             String                    @unique
  approvalStatus     VendorApprovalStatus      @default(PENDING)
  approvalNote       String?
  subscriptionStatus VendorSubscriptionStatus?
  trialEndsAt        DateTime?
  activeUntil        DateTime?
  createdAt          DateTime                  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorCoverage {
  id           String       @id @default(cuid())
  vendorId     String       @unique
  coverageType CoverageType
  cities       Json?
  pincodes     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model EngineerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  city      String?
  skills    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========================================
// C) NOTIFICATIONS
// ========================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushLogs PushNotificationLog[]

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ========================================
// D) CATALOG
// ========================================

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  subCategories        SubCategory[]
  serviceItems         ServiceItem[]
  partItems            PartItem[]
  restaurantCategories RestaurantCategory[]
  vendorProducts       VendorProduct[]

  @@index([isActive])
}

model SubCategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceItems ServiceItem[]
  partItems    PartItem[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model ServiceItem {
  id            String    @id @default(cuid())
  categoryId    String
  subCategoryId String?
  name          String
  description   String?
  price         Int // in paise (1 INR = 100 paise)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory  SubCategory?         @relation(fields: [subCategoryId], references: [id])
  cartItems    CartItem[]
  bookingItems ServiceBookingItem[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isActive])
}

model PartItem {
  id            String    @id @default(cuid())
  categoryId    String
  subCategoryId String?
  name          String
  description   String?
  price         Int // in paise
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory  SubCategory?         @relation(fields: [subCategoryId], references: [id])
  cartItems    CartItem[]
  bookingItems ServiceBookingItem[]
  inventory    WarehouseInventory?

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isActive])
}

// ========================================
// E) OWNER RESTAURANT
// ========================================

model Restaurant {
  id                  String           @id @default(cuid())
  ownerId             String
  name                String
  address             String
  city                String
  pincode             String?
  restaurantImageUrl  String?
  fssaiNumber         String?
  fssaiCertificateUrl String?
  status              RestaurantStatus @default(PENDING)
  rejectionReason     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  owner             User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members           RestaurantMember[]
  categories        RestaurantCategory[]
  categoryRequests  CategoryRequest[]
  carts             Cart[]
  serviceBookings   ServiceBooking[]
  marketplaceOrders MarketplaceOrder[]
  equipments        Equipment[]
  amcSubscriptions  AMCSubscription[]
  expenses          Expense[]

  @@index([ownerId])
  @@index([status])
  @@index([fssaiNumber])
}

model RestaurantMember {
  id              String         @id @default(cuid())
  restaurantId    String
  userId          String
  role            RestaurantRole
  invitedBy       String
  inviteToken     String?        @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime       @default(now())
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation("RestaurantMember", fields: [userId], references: [id], onDelete: Cascade)
  inviter    User       @relation("RestaurantInviter", fields: [invitedBy], references: [id])

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
  @@index([invitedBy])
  @@index([inviteToken])
}

model RestaurantCategory {
  id           String @id @default(cuid())
  restaurantId String
  categoryId   String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, categoryId])
  @@index([restaurantId])
  @@index([categoryId])
}

model CategoryRequest {
  id              String                @id @default(cuid())
  ownerId         String
  restaurantId    String?
  requestedName   String
  description     String?
  reason          String?
  status          CategoryRequestStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime              @default(now())

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([ownerId])
  @@index([status])
}

// ========================================
// F) CART + BOOKING
// ========================================

model Cart {
  id           String     @id @default(cuid())
  ownerId      String
  restaurantId String
  status       CartStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@unique([ownerId, restaurantId, status])
  @@index([ownerId])
  @@index([restaurantId])
}

model CartItem {
  id            String       @id @default(cuid())
  cartId        String
  itemType      CartItemType
  serviceItemId String?
  partItemId    String?
  qty           Int
  priceSnapshot Int
  createdAt     DateTime     @default(now())

  cart        Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem? @relation(fields: [serviceItemId], references: [id])
  partItem    PartItem?    @relation(fields: [partItemId], references: [id])

  @@index([cartId])
}

model ServiceBooking {
  id                     String               @id @default(cuid())
  ownerId                String
  restaurantId           String
  slotStartDateTime      DateTime?
  slotEndDateTime        DateTime?
  adminAdjustedSlotStart DateTime?
  adminAdjustedSlotEnd   DateTime?
  status                 ServiceBookingStatus @default(DRAFT)
  totalAmount            Int
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items               ServiceBookingItem[]
  paymentProof        PaymentProof?
  engineerAssignments EngineerAssignment[]
  amcUsage            AMCServiceUse[]
  stockMovements      StockMovement[]

  @@index([ownerId])
  @@index([restaurantId])
  @@index([status])
  @@index([slotStartDateTime])
}

model ServiceBookingItem {
  id            String       @id @default(cuid())
  bookingId     String
  itemType      CartItemType
  serviceItemId String?
  partItemId    String?
  qty           Int
  priceSnapshot Int

  booking     ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem?   @relation(fields: [serviceItemId], references: [id])
  partItem    PartItem?      @relation(fields: [partItemId], references: [id])

  @@index([bookingId])
}

model PaymentProof {
  id            String             @id @default(cuid())
  bookingId     String             @unique
  ownerId       String
  screenshotUrl String
  status        PaymentProofStatus @default(UPLOADED)
  adminNote     String?
  createdAt     DateTime           @default(now())
  verifiedAt    DateTime?

  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
}

model EngineerAssignment {
  id               String                   @id @default(cuid())
  bookingId        String
  engineerId       String
  status           EngineerAssignmentStatus @default(PENDING)
  assignedAt       DateTime                 @default(now())
  respondedAt      DateTime?
  completedAt      DateTime?
  commissionAmount Int? // Commission in paise (earned when completed)
  commissionRate   Int                      @default(20) // Commission percentage (default 20%)

  booking  ServiceBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  engineer User             @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  workLog  EngineerWorkLog?
  payout   Payout?

  @@unique([bookingId, engineerId])
  @@index([bookingId])
  @@index([engineerId])
  @@index([status])
}

model EngineerWorkLog {
  id             String   @id @default(cuid())
  assignmentId   String   @unique
  completionNote String
  proofImageUrls Json? // Array of image URLs (max 5)
  createdAt      DateTime @default(now())

  assignment EngineerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

// ========================================
// G) MARKETPLACE
// ========================================

model VendorProduct {
  id            String    @id @default(cuid())
  vendorId      String
  categoryId    String?
  name          String
  description   String?
  price         Int // in paise
  unit          String // kg, ltr, piece, etc.
  stockQuantity Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  vendor     User                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category?              @relation(fields: [categoryId], references: [id])
  orderItems MarketplaceOrderItem[]

  @@index([vendorId])
  @@index([isActive])
  @@index([categoryId])
}

model MarketplaceOrder {
  id           String                 @id @default(cuid())
  ownerId      String
  vendorId     String
  restaurantId String
  status       MarketplaceOrderStatus @default(PLACED)
  totalAmount  Int
  createdAt    DateTime               @default(now())

  owner      User                   @relation("OwnerOrders", fields: [ownerId], references: [id], onDelete: Cascade)
  vendor     User                   @relation("VendorOrders", fields: [vendorId], references: [id], onDelete: Cascade)
  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MarketplaceOrderItem[]

  @@index([ownerId])
  @@index([vendorId])
  @@index([createdAt])
}

model MarketplaceOrderItem {
  id              String @id @default(cuid())
  orderId         String
  vendorProductId String
  qty             Int
  priceSnapshot   Int

  order   MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product VendorProduct    @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ========================================
// H) AUDIT LOG
// ========================================

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  metaJson    String?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([createdAt])
}

// ========================================
// I) PAYMENT SETTINGS
// ========================================

model PaymentSettings {
  id                String   @id @default(cuid())
  qrCodeImageUrl    String   @db.Text // UPI QR code image URL
  upiId             String // UPI ID (e.g., merchant@upi)
  accountHolderName String // Business name
  instructions      String?  @db.Text // Payment instructions for customers
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
}

// ========================================
// J) ENGINEER PAYOUTS
// ========================================

model Payout {
  id           String       @id @default(cuid())
  assignmentId String       @unique
  engineerId   String
  amount       Int // Payout amount in paise
  status       PayoutStatus @default(PENDING)
  paidAt       DateTime?
  paymentNote  String?      @db.Text // Admin notes about payment
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignment EngineerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  engineer   User               @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@index([engineerId])
  @@index([status])
  @@index([createdAt])
}

// ========================================
// K) EQUIPMENT MANAGEMENT
// ========================================

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum AMCDuration {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AMCSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum StockMovementType {
  INWARD_PURCHASE
  INWARD_RETURN
  OUTWARD_USAGE
  OUTWARD_WASTAGE
  ADJUSTMENT
}

enum ExpenseCategory {
  FOOD
  UTILITIES
  SALARIES
  MAINTENANCE
  RENT
  SUPPLIES
  MARKETING
  TRANSPORT
  OTHER
}

model Equipment {
  id              String          @id @default(cuid())
  ownerId         String
  restaurantId    String
  name            String
  category        String
  purchaseDate    DateTime
  warrantyEndDate DateTime?
  serialNumber    String?
  billImageUrl    String?
  warrantyCardUrl String?
  photoUrls       Json? // Array of equipment photo URLs (max 5)
  status          EquipmentStatus @default(AVAILABLE)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amcSubscription AMCSubscription[]

  @@index([ownerId])
  @@index([restaurantId])
  @@index([status])
  @@index([warrantyEndDate])
}

// ========================================
// L) AMC (ANNUAL MAINTENANCE CONTRACT)
// ========================================

model AMCPlan {
  id           String      @id @default(cuid())
  name         String      @unique
  description  String?     @db.Text
  duration     AMCDuration
  price        Int // in paise
  serviceLimit Int // Number of services included
  featuresJson Json? // Array of features
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  subscriptions AMCSubscription[]

  @@index([isActive])
}

model AMCSubscription {
  id              String                @id @default(cuid())
  equipmentId     String
  ownerId         String
  restaurantId    String
  planId          String? // Optional: null if custom plan, set if using admin template
  // Custom Plan Fields (owner-defined)
  planName        String?
  planDescription String?               @db.Text
  duration        AMCDuration
  serviceLimit    Int
  featuresJson    Json? // Array of feature strings
  // Subscription Details
  startDate       DateTime
  endDate         DateTime
  status          AMCSubscriptionStatus @default(ACTIVE)
  autoRenew       Boolean               @default(false)
  servicesUsed    Int                   @default(0)
  totalAmount     Int // Cost in paise (owner can set their own pricing)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  cancelledAt     DateTime?

  equipment  Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  plan       AMCPlan?        @relation(fields: [planId], references: [id])
  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  usageLogs  AMCServiceUse[]

  @@index([ownerId])
  @@index([restaurantId])
  @@index([equipmentId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

model AMCServiceUse {
  id             String   @id @default(cuid())
  subscriptionId String
  bookingId      String?
  serviceDate    DateTime
  serviceType    String
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  subscription AMCSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  booking      ServiceBooking? @relation(fields: [bookingId], references: [id])

  @@index([subscriptionId])
  @@index([bookingId])
}

// ========================================
// M) WAREHOUSE MANAGEMENT
// ========================================

model WarehouseInventory {
  id                String    @id @default(cuid())
  partItemId        String    @unique
  currentStock      Int       @default(0)
  lowStockThreshold Int       @default(10)
  lastRestockedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  partItem       PartItem        @relation(fields: [partItemId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([currentStock])
  @@index([lowStockThreshold])
}

model StockMovement {
  id           String            @id @default(cuid())
  inventoryId  String
  movementType StockMovementType
  quantity     Int
  balanceAfter Int
  bookingId    String?
  notes        String?           @db.Text
  createdBy    String
  createdAt    DateTime          @default(now())

  inventory WarehouseInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  booking   ServiceBooking?    @relation(fields: [bookingId], references: [id])
  creator   User               @relation(fields: [createdBy], references: [id])

  @@index([inventoryId])
  @@index([movementType])
  @@index([bookingId])
  @@index([createdAt])
}

// ========================================
// N) EXPENSE TRACKING
// ========================================

model Expense {
  id              String          @id @default(cuid())
  ownerId         String
  restaurantId    String
  category        ExpenseCategory
  amount          Int // in paise
  expenseDate     DateTime
  description     String
  receiptImageUrl String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([restaurantId])
  @@index([category])
  @@index([expenseDate])
}

// ========================================
// O) FIREBASE PUSH NOTIFICATIONS
// ========================================

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  deviceId  String?
  platform  String   @default("web")
  isActive  Boolean  @default(true)
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  enablePush         Boolean  @default(true)
  enableEmail        Boolean  @default(true)
  enableInApp        Boolean  @default(true)
  notifyOnPayment    Boolean  @default(true)
  notifyOnBooking    Boolean  @default(true)
  notifyOnEngineer   Boolean  @default(true)
  notifyOnCompletion Boolean  @default(true)
  notifyOnOrder      Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushNotificationLog {
  id             String    @id @default(cuid())
  notificationId String?
  userId         String
  fcmMessageId   String?
  title          String
  body           String
  data           Json?
  status         String
  errorMessage   String?   @db.Text
  sentAt         DateTime  @default(now())
  deliveredAt    DateTime?
  clickedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([notificationId])
  @@index([status])
}
