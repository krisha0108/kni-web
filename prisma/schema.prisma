// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========================================
// ENUMS
// ========================================

enum Role {
  ADMIN
  OWNER
  VENDOR
  ENGINEER
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentProofStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum ServiceBookingStatus {
  DRAFT
  SLOT_SELECTED
  PAYMENT_UPLOADED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  ENGINEER_ASSIGNED
  ACCEPTED_BY_ENGINEER
  REJECTED_BY_ENGINEER
  COMPLETED
  CANCELLED
}

enum EngineerAssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum VendorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorSubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  BLOCKED
}

enum MarketplaceOrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CartItemType {
  SERVICE
  PART
}

enum CartStatus {
  DRAFT
  SUBMITTED
  ARCHIVED
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum CoverageType {
  CITY_WIDE
  PINCODE_WISE
}

enum RestaurantRole {
  OWNER
  MANAGER
  ACCOUNTANT
  VIEWER
}

enum NotificationType {
  BOOKING
  PAYMENT
  ORDER
  AMC
  EQUIPMENT
  SYSTEM
  ANNOUNCEMENT
}

enum OTPPurpose {
  LOGIN
  REGISTRATION
  PASSWORD_RESET
  PHONE_VERIFICATION
  BOOKING_CONFIRMATION
}

enum SMSStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum KhatabookSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

enum KhatabookTransactionType {
  BOOKING_REVENUE
  MARKETPLACE_ORDER
  EXPENSE
  ENGINEER_PAYOUT
  AMC_REVENUE
}

enum RatingCategory {
  PRODUCT_QUALITY
  DELIVERY_TIME
  CUSTOMER_SERVICE
  VALUE_FOR_MONEY
  PACKAGING
}

enum EngineerRatingCategory {
  PROFESSIONALISM
  TECHNICAL_SKILL
  COMMUNICATION
  PUNCTUALITY
  PROBLEM_SOLVING
}

// ========================================
// A) AUTH
// ========================================

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  sessions               Session[]
  ownerProfile           OwnerProfile?
  vendorProfile          VendorProfile?
  vendorCoverage         VendorCoverage?
  engineerProfile        EngineerProfile?
  notifications          Notification[]
  restaurants            Restaurant[]
  categoryRequests       CategoryRequest[]
  carts                  Cart[]
  serviceBookings        ServiceBooking[]
  paymentProofs          PaymentProof[]
  engineerAssignments    EngineerAssignment[]
  vendorProducts         VendorProduct[]
  marketplaceOrders      MarketplaceOrder[]      @relation("OwnerOrders")
  vendorOrders           MarketplaceOrder[]      @relation("VendorOrders")
  auditLogs              AuditLog[]
  payouts                Payout[]
  equipments             Equipment[]
  amcSubscriptions       AMCSubscription[]
  stockMovements         StockMovement[]
  expenses               Expense[]
  deviceTokens           DeviceToken[]
  notificationPreference NotificationPreference?
  pushNotificationLogs     PushNotificationLog[]
  restaurantMemberships    RestaurantMember[]      @relation("RestaurantMember")
  restaurantInvites        RestaurantMember[]      @relation("RestaurantInviter")
  orderStatusHistoryChanges OrderStatusHistory[]
  vendorRatingsReceived    VendorRating[]          @relation("VendorRatings")
  vendorRatingsGiven       VendorRating[]          @relation("OwnerVendorRatings")
  engineerRatingsReceived  EngineerRating[]        @relation("EngineerRatings")
  engineerRatingsGiven     EngineerRating[]        @relation("OwnerEngineerRatings")
  vendorStats              VendorStats?            @relation("VendorStats")
  engineerStats            EngineerStats?          @relation("EngineerStats")

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ========================================
// B) PROFILES
// ========================================

model OwnerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorProfile {
  id                 String                    @id @default(cuid())
  userId             String                    @unique
  approvalStatus     VendorApprovalStatus      @default(PENDING)
  approvalNote       String?
  subscriptionStatus VendorSubscriptionStatus?
  trialEndsAt        DateTime?
  activeUntil        DateTime?
  createdAt          DateTime                  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorCoverage {
  id           String       @id @default(cuid())
  vendorId     String       @unique
  coverageType CoverageType
  cities       Json?
  pincodes     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model EngineerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  city      String?
  skills    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========================================
// C) NOTIFICATIONS
// ========================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushLogs PushNotificationLog[]

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

// ========================================
// D) CATALOG
// ========================================

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  subCategories        SubCategory[]
  serviceItems         ServiceItem[]
  partItems            PartItem[]
  restaurantCategories RestaurantCategory[]
  vendorProducts       VendorProduct[]

  @@index([isActive])
}

model SubCategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceItems ServiceItem[]
  partItems    PartItem[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model ServiceItem {
  id            String    @id @default(cuid())
  categoryId    String
  subCategoryId String?
  name          String
  description   String?
  price         Int // in paise (1 INR = 100 paise)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory  SubCategory?         @relation(fields: [subCategoryId], references: [id])
  cartItems    CartItem[]
  bookingItems ServiceBookingItem[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isActive])
}

model PartItem {
  id            String    @id @default(cuid())
  categoryId    String
  subCategoryId String?
  name          String
  description   String?
  price         Int // in paise
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory  SubCategory?         @relation(fields: [subCategoryId], references: [id])
  cartItems    CartItem[]
  bookingItems ServiceBookingItem[]
  inventory    WarehouseInventory?

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isActive])
}

// ========================================
// E) OWNER RESTAURANT
// ========================================

model Restaurant {
  id                  String           @id @default(cuid())
  ownerId             String
  name                String
  address             String
  city                String
  pincode             String?
  restaurantImageUrl  String?
  fssaiNumber         String?
  fssaiCertificateUrl String?
  status              RestaurantStatus @default(PENDING)
  rejectionReason     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  owner             User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members           RestaurantMember[]
  categories        RestaurantCategory[]
  categoryRequests  CategoryRequest[]
  carts             Cart[]
  serviceBookings   ServiceBooking[]
  marketplaceOrders MarketplaceOrder[]
  equipments        Equipment[]
  amcSubscriptions  AMCSubscription[]
  expenses          Expense[]
  vendorRatings     VendorRating[]
  engineerRatings   EngineerRating[]

  @@index([ownerId])
  @@index([status])
  @@index([fssaiNumber])
}

model RestaurantMember {
  id              String         @id @default(cuid())
  restaurantId    String
  userId          String
  role            RestaurantRole
  invitedBy       String
  inviteToken     String?        @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime       @default(now())
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation("RestaurantMember", fields: [userId], references: [id], onDelete: Cascade)
  inviter    User       @relation("RestaurantInviter", fields: [invitedBy], references: [id])

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
  @@index([invitedBy])
  @@index([inviteToken])
}

model RestaurantCategory {
  id           String @id @default(cuid())
  restaurantId String
  categoryId   String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, categoryId])
  @@index([restaurantId])
  @@index([categoryId])
}

model CategoryRequest {
  id              String                @id @default(cuid())
  ownerId         String
  restaurantId    String?
  requestedName   String
  description     String?
  reason          String?
  status          CategoryRequestStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime              @default(now())

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([ownerId])
  @@index([status])
}

// ========================================
// F) CART + BOOKING
// ========================================

model Cart {
  id           String     @id @default(cuid())
  ownerId      String
  restaurantId String
  status       CartStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@unique([ownerId, restaurantId, status])
  @@index([ownerId])
  @@index([restaurantId])
}

model CartItem {
  id            String       @id @default(cuid())
  cartId        String
  itemType      CartItemType
  serviceItemId String?
  partItemId    String?
  qty           Int
  priceSnapshot Int
  createdAt     DateTime     @default(now())

  cart        Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem? @relation(fields: [serviceItemId], references: [id])
  partItem    PartItem?    @relation(fields: [partItemId], references: [id])

  @@index([cartId])
}

model ServiceBooking {
  id                     String               @id @default(cuid())
  ownerId                String
  restaurantId           String
  slotStartDateTime      DateTime?
  slotEndDateTime        DateTime?
  adminAdjustedSlotStart DateTime?
  adminAdjustedSlotEnd   DateTime?
  status                 ServiceBookingStatus @default(DRAFT)
  totalAmount            Int
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items               ServiceBookingItem[]
  paymentProof        PaymentProof?
  engineerAssignments EngineerAssignment[]
  amcUsage            AMCServiceUse[]
  stockMovements      StockMovement[]
  engineerRatings     EngineerRating[]

  @@index([ownerId])
  @@index([restaurantId])
  @@index([status])
  @@index([slotStartDateTime])
}

model ServiceBookingItem {
  id            String       @id @default(cuid())
  bookingId     String
  itemType      CartItemType
  serviceItemId String?
  partItemId    String?
  qty           Int
  priceSnapshot Int

  booking     ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem?   @relation(fields: [serviceItemId], references: [id])
  partItem    PartItem?      @relation(fields: [partItemId], references: [id])

  @@index([bookingId])
}

model PaymentProof {
  id            String             @id @default(cuid())
  bookingId     String             @unique
  ownerId       String
  screenshotUrl String
  status        PaymentProofStatus @default(UPLOADED)
  adminNote     String?
  createdAt     DateTime           @default(now())
  verifiedAt    DateTime?

  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
}

model EngineerAssignment {
  id               String                   @id @default(cuid())
  bookingId        String
  engineerId       String
  status           EngineerAssignmentStatus @default(PENDING)
  assignedAt       DateTime                 @default(now())
  respondedAt      DateTime?
  completedAt      DateTime?
  commissionAmount Int? // Commission in paise (earned when completed)
  commissionRate   Int                      @default(20) // Commission percentage (default 20%)

  booking  ServiceBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  engineer User             @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  workLog  EngineerWorkLog?
  payout   Payout?
  rating   EngineerRating?

  @@unique([bookingId, engineerId])
  @@index([bookingId])
  @@index([engineerId])
  @@index([status])
}

model EngineerWorkLog {
  id             String   @id @default(cuid())
  assignmentId   String   @unique
  completionNote String
  proofImageUrls Json? // Array of image URLs (max 5)
  createdAt      DateTime @default(now())

  assignment EngineerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

// ========================================
// G) MARKETPLACE
// ========================================

model VendorProduct {
  id            String    @id @default(cuid())
  vendorId      String
  categoryId    String?
  name          String
  description   String?
  price         Int // in paise
  unit          String // kg, ltr, piece, etc.
  stockQuantity Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  vendor     User                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category?              @relation(fields: [categoryId], references: [id])
  orderItems MarketplaceOrderItem[]

  @@index([vendorId])
  @@index([isActive])
  @@index([categoryId])
}

model MarketplaceOrder {
  id              String                 @id @default(cuid())
  ownerId         String
  vendorId        String
  restaurantId    String
  status          MarketplaceOrderStatus @default(PLACED)
  totalAmount     Int
  statusNotes     String?                @db.Text
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  statusUpdatedAt DateTime               @default(now())

  owner         User                   @relation("OwnerOrders", fields: [ownerId], references: [id], onDelete: Cascade)
  vendor        User                   @relation("VendorOrders", fields: [vendorId], references: [id], onDelete: Cascade)
  restaurant    Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         MarketplaceOrderItem[]
  statusHistory OrderStatusHistory[]
  rating        VendorRating?

  @@index([ownerId])
  @@index([vendorId])
  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
}

model MarketplaceOrderItem {
  id              String @id @default(cuid())
  orderId         String
  vendorProductId String
  qty             Int
  priceSnapshot   Int

  order   MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product VendorProduct    @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusHistory {
  id          String                 @id @default(cuid())
  orderId     String
  oldStatus   MarketplaceOrderStatus?
  newStatus   MarketplaceOrderStatus
  notes       String?                @db.Text
  changedBy   String
  createdAt   DateTime               @default(now())

  order      MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User          @relation(fields: [changedBy], references: [id])

  @@index([orderId])
  @@index([changedBy])
  @@index([createdAt])
}

// ========================================
// H) AUDIT LOG
// ========================================

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  metaJson    String?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([createdAt])
}

// ========================================
// I) PAYMENT SETTINGS
// ========================================

model PaymentSettings {
  id                String   @id @default(cuid())
  qrCodeImageUrl    String   @db.Text // UPI QR code image URL
  upiId             String // UPI ID (e.g., merchant@upi)
  accountHolderName String // Business name
  instructions      String?  @db.Text // Payment instructions for customers
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
}

// ========================================
// J) ENGINEER PAYOUTS
// ========================================

model Payout {
  id           String       @id @default(cuid())
  assignmentId String       @unique
  engineerId   String
  amount       Int // Payout amount in paise
  status       PayoutStatus @default(PENDING)
  paidAt       DateTime?
  paymentNote  String?      @db.Text // Admin notes about payment
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignment EngineerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  engineer   User               @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@index([engineerId])
  @@index([status])
  @@index([createdAt])
}

// ========================================
// K) EQUIPMENT MANAGEMENT
// ========================================

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum AMCDuration {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AMCSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum StockMovementType {
  INWARD_PURCHASE
  INWARD_RETURN
  OUTWARD_USAGE
  OUTWARD_WASTAGE
  ADJUSTMENT
}

enum ExpenseCategory {
  FOOD
  UTILITIES
  SALARIES
  MAINTENANCE
  RENT
  SUPPLIES
  MARKETING
  TRANSPORT
  OTHER
}

model Equipment {
  id              String          @id @default(cuid())
  ownerId         String
  restaurantId    String
  name            String
  category        String
  purchaseDate    DateTime
  warrantyEndDate DateTime?
  serialNumber    String?
  billImageUrl    String?
  warrantyCardUrl String?
  photoUrls       Json? // Array of equipment photo URLs (max 5)
  status          EquipmentStatus @default(AVAILABLE)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amcSubscription AMCSubscription[]

  @@index([ownerId])
  @@index([restaurantId])
  @@index([status])
  @@index([warrantyEndDate])
}

// ========================================
// L) AMC (ANNUAL MAINTENANCE CONTRACT)
// ========================================

model AMCPlan {
  id           String      @id @default(cuid())
  name         String      @unique
  description  String?     @db.Text
  duration     AMCDuration
  price        Int // in paise
  serviceLimit Int // Number of services included
  featuresJson Json? // Array of features
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  subscriptions AMCSubscription[]

  @@index([isActive])
}

model AMCSubscription {
  id              String                @id @default(cuid())
  equipmentId     String
  ownerId         String
  restaurantId    String
  planId          String? // Optional: null if custom plan, set if using admin template
  // Custom Plan Fields (owner-defined)
  planName        String?
  planDescription String?               @db.Text
  duration        AMCDuration
  serviceLimit    Int
  featuresJson    Json? // Array of feature strings
  // Subscription Details
  startDate       DateTime
  endDate         DateTime
  status          AMCSubscriptionStatus @default(ACTIVE)
  autoRenew       Boolean               @default(false)
  servicesUsed    Int                   @default(0)
  totalAmount     Int // Cost in paise (owner can set their own pricing)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  cancelledAt     DateTime?

  equipment  Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  plan       AMCPlan?        @relation(fields: [planId], references: [id])
  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  usageLogs  AMCServiceUse[]

  @@index([ownerId])
  @@index([restaurantId])
  @@index([equipmentId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

model AMCServiceUse {
  id             String   @id @default(cuid())
  subscriptionId String
  bookingId      String?
  serviceDate    DateTime
  serviceType    String
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  subscription AMCSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  booking      ServiceBooking? @relation(fields: [bookingId], references: [id])

  @@index([subscriptionId])
  @@index([bookingId])
}

// ========================================
// M) WAREHOUSE MANAGEMENT
// ========================================

model WarehouseInventory {
  id                String    @id @default(cuid())
  partItemId        String    @unique
  currentStock      Int       @default(0)
  lowStockThreshold Int       @default(10)
  lastRestockedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  partItem       PartItem        @relation(fields: [partItemId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([currentStock])
  @@index([lowStockThreshold])
}

model StockMovement {
  id           String            @id @default(cuid())
  inventoryId  String
  movementType StockMovementType
  quantity     Int
  balanceAfter Int
  bookingId    String?
  notes        String?           @db.Text
  createdBy    String
  createdAt    DateTime          @default(now())

  inventory WarehouseInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  booking   ServiceBooking?    @relation(fields: [bookingId], references: [id])
  creator   User               @relation(fields: [createdBy], references: [id])

  @@index([inventoryId])
  @@index([movementType])
  @@index([bookingId])
  @@index([createdAt])
}

// ========================================
// N) EXPENSE TRACKING
// ========================================

model Expense {
  id              String          @id @default(cuid())
  ownerId         String
  restaurantId    String
  category        ExpenseCategory
  amount          Int // in paise
  expenseDate     DateTime
  description     String
  receiptImageUrl String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([restaurantId])
  @@index([category])
  @@index([expenseDate])
}

// ========================================
// O) FIREBASE PUSH NOTIFICATIONS
// ========================================

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  deviceId  String?
  platform  String   @default("web")
  isActive  Boolean  @default(true)
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  enablePush         Boolean  @default(true)
  enableEmail        Boolean  @default(true)
  enableInApp        Boolean  @default(true)
  notifyOnPayment    Boolean  @default(true)
  notifyOnBooking    Boolean  @default(true)
  notifyOnEngineer   Boolean  @default(true)
  notifyOnCompletion Boolean  @default(true)
  notifyOnOrder      Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushNotificationLog {
  id             String    @id @default(cuid())
  notificationId String?
  userId         String
  fcmMessageId   String?
  title          String
  body           String
  data           Json?
  status         String
  errorMessage   String?   @db.Text
  sentAt         DateTime  @default(now())
  deliveredAt    DateTime?
  clickedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([notificationId])
  @@index([status])
}

// ========================================
// P) SMS NOTIFICATIONS & OTP
// ========================================

model OTP {
  id         String     @id @default(cuid())
  phone      String
  code       String // 6-digit OTP code
  purpose    OTPPurpose
  isVerified Boolean    @default(false)
  attempts   Int        @default(0) // Track verification attempts
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone])
  @@index([phone, purpose, isVerified])
  @@index([expiresAt])
}

model SMSLog {
  id           String    @id @default(cuid())
  phone        String
  message      String    @db.Text
  purpose      String? // LOGIN, BOOKING, PAYMENT, etc.
  status       SMSStatus @default(PENDING)
  providerId   String? // External SMS provider's message ID
  errorMessage String?   @db.Text
  sentAt       DateTime  @default(now())
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([phone])
  @@index([status])
  @@index([sentAt])
  @@index([purpose])
}

model SMSTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  purpose     String // LOGIN_OTP, BOOKING_CONFIRMATION, PAYMENT_RECEIVED, etc.
  template    String   @db.Text // Template with variables like {{name}}, {{otp}}, {{amount}}
  variables   Json? // Array of variable names used in template
  isActive    Boolean  @default(true)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([purpose])
  @@index([isActive])
}

// ========================================
// Q) KHATABOOK FINANCE INTEGRATION
// ========================================

model KhatabookConnection {
  id            String   @id @default(cuid())
  userId        String   @unique // Restaurant owner's user ID
  restaurantId  String? // Optional: specific restaurant, null means all
  businessId    String // Khatabook business ID
  businessName  String
  accessToken   String   @db.Text // Encrypted access token
  refreshToken  String?  @db.Text // Encrypted refresh token
  tokenExpiresAt DateTime?
  isActive      Boolean  @default(true)
  autoSync      Boolean  @default(true) // Auto-sync transactions
  lastSyncAt    DateTime?
  syncError     String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions KhatabookTransaction[]

  @@index([userId])
  @@index([restaurantId])
  @@index([isActive])
}

model KhatabookTransaction {
  id             String                     @id @default(cuid())
  connectionId   String
  transactionType KhatabookTransactionType
  entityType     String // "BOOKING", "ORDER", "EXPENSE", "PAYOUT", "AMC"
  entityId       String // ID of the booking/order/expense/payout
  khatabookId    String? // Khatabook's transaction ID after sync
  amount         Int // Amount in paise
  description    String   @db.Text
  customerName   String?
  date           DateTime
  syncStatus     KhatabookSyncStatus        @default(PENDING)
  syncAttempts   Int                        @default(0)
  lastSyncAt     DateTime?
  syncError      String?                    @db.Text
  metadata       Json? // Additional data (invoice number, payment method, etc.)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  connection KhatabookConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([connectionId])
  @@index([syncStatus])
  @@index([transactionType])
  @@index([date])
  @@index([khatabookId])
}

model KhatabookSyncLog {
  id           String   @id @default(cuid())
  connectionId String
  syncType     String // "MANUAL", "AUTO", "WEBHOOK"
  status       String // "SUCCESS", "PARTIAL", "FAILED"
  itemsSynced  Int      @default(0)
  itemsFailed  Int      @default(0)
  errorMessage String?  @db.Text
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  duration     Int? // Duration in milliseconds

  @@index([connectionId])
  @@index([status])
  @@index([startedAt])
}

// ========================================
// R) RATINGS & REVIEWS
// ========================================

model VendorRating {
  id               String    @id @default(cuid())
  orderId          String    @unique
  vendorId         String
  ownerId          String
  restaurantId     String
  overallRating    Int // 1-5 stars
  productQuality   Int? // 1-5
  deliveryTime     Int? // 1-5
  customerService  Int? // 1-5
  valueForMoney    Int? // 1-5
  packaging        Int? // 1-5
  review           String?   @db.Text
  images           Json? // Array of image URLs
  isVerifiedPurchase Boolean @default(true)
  isPublished      Boolean   @default(true)
  adminResponse    String?   @db.Text
  respondedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order      MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor     User             @relation("VendorRatings", fields: [vendorId], references: [id], onDelete: Cascade)
  owner      User             @relation("OwnerVendorRatings", fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([ownerId])
  @@index([restaurantId])
  @@index([overallRating])
  @@index([createdAt])
}

model EngineerRating {
  id               String    @id @default(cuid())
  assignmentId     String    @unique
  engineerId       String
  ownerId          String
  restaurantId     String
  bookingId        String
  overallRating    Int // 1-5 stars
  professionalism  Int? // 1-5
  technicalSkill   Int? // 1-5
  communication    Int? // 1-5
  punctuality      Int? // 1-5
  problemSolving   Int? // 1-5
  review           String?   @db.Text
  images           Json? // Array of image URLs
  isPublished      Boolean   @default(true)
  adminResponse    String?   @db.Text
  respondedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignment EngineerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  engineer   User               @relation("EngineerRatings", fields: [engineerId], references: [id], onDelete: Cascade)
  owner      User               @relation("OwnerEngineerRatings", fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  booking    ServiceBooking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([engineerId])
  @@index([ownerId])
  @@index([restaurantId])
  @@index([bookingId])
  @@index([overallRating])
  @@index([createdAt])
}

model VendorStats {
  id                    String   @id @default(cuid())
  vendorId              String   @unique
  averageRating         Float    @default(0)
  totalRatings          Int      @default(0)
  fiveStarCount         Int      @default(0)
  fourStarCount         Int      @default(0)
  threeStarCount        Int      @default(0)
  twoStarCount          Int      @default(0)
  oneStarCount          Int      @default(0)
  averageProductQuality Float?
  averageDeliveryTime   Float?
  averageCustomerService Float?
  averageValueForMoney  Float?
  averagePackaging      Float?
  updatedAt             DateTime @updatedAt

  vendor User @relation("VendorStats", fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([averageRating])
  @@index([totalRatings])
}

model EngineerStats {
  id                     String   @id @default(cuid())
  engineerId             String   @unique
  averageRating          Float    @default(0)
  totalRatings           Int      @default(0)
  fiveStarCount          Int      @default(0)
  fourStarCount          Int      @default(0)
  threeStarCount         Int      @default(0)
  twoStarCount           Int      @default(0)
  oneStarCount           Int      @default(0)
  averageProfessionalism Float?
  averageTechnicalSkill  Float?
  averageCommunication   Float?
  averagePunctuality     Float?
  averageProblemSolving  Float?
  updatedAt              DateTime @updatedAt

  engineer User @relation("EngineerStats", fields: [engineerId], references: [id], onDelete: Cascade)

  @@index([averageRating])
  @@index([totalRatings])
}
