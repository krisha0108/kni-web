// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========================================
// ENUMS
// ========================================

enum Role {
  ADMIN
  OWNER
  VENDOR
  ENGINEER
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentProofStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum ServiceBookingStatus {
  DRAFT
  SLOT_SELECTED
  PAYMENT_UPLOADED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  ENGINEER_ASSIGNED
  ACCEPTED_BY_ENGINEER
  IN_PROGRESS // Engineer has started work
  REJECTED_BY_ENGINEER
  COMPLETED
  CANCELLED
}

enum EngineerAssignmentStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS // Engineer has started work
  REJECTED
  COMPLETED
}

enum VendorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorSubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  BLOCKED
}

enum MarketplaceOrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CartItemType {
  SERVICE
  PART
}

enum CartStatus {
  DRAFT
  SUBMITTED
  ARCHIVED
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum CoverageType {
  CITY_WIDE
  PINCODE_WISE
}

enum RestaurantRole {
  OWNER
  MANAGER
  ACCOUNTANT
  VIEWER
}

enum NotificationType {
  BOOKING
  PAYMENT
  ORDER
  AMC
  EQUIPMENT
  SYSTEM
  ANNOUNCEMENT
}

enum OTPPurpose {
  LOGIN
  REGISTRATION
  PASSWORD_RESET
  PHONE_VERIFICATION
  BOOKING_CONFIRMATION
}

enum SMSStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum KhatabookSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

enum KhatabookTransactionType {
  BOOKING_REVENUE
  MARKETPLACE_ORDER
  EXPENSE
  ENGINEER_PAYOUT
  AMC_REVENUE
}

enum RatingCategory {
  PRODUCT_QUALITY
  DELIVERY_TIME
  CUSTOMER_SERVICE
  VALUE_FOR_MONEY
  PACKAGING
}

enum EngineerRatingCategory {
  PROFESSIONALISM
  TECHNICAL_SKILL
  COMMUNICATION
  PUNCTUALITY
  PROBLEM_SOLVING
}

// ========================================
// A) AUTH
// ========================================

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  sessions               Session[]
  ownerProfile           OwnerProfile?
  vendorProfile          VendorProfile?
  vendorCoverage         VendorCoverage?
  engineerProfile        EngineerProfile?
  notifications          Notification[]
  restaurants            Restaurant[]
  categoryRequests       CategoryRequest[]
  carts                  Cart[]
  serviceBookings        ServiceBooking[]
  paymentProofs          PaymentProof[]
  engineerAssignments    EngineerAssignment[]
  vendorProducts         VendorProduct[]
  marketplaceOrders      MarketplaceOrder[]      @relation("OwnerOrders")
  vendorOrders           MarketplaceOrder[]      @relation("VendorOrders")
  auditLogs              AuditLog[]
  payouts                Payout[]
  equipments             Equipment[]
  amcSubscriptions       AMCSubscription[]
  stockMovements         StockMovement[]
  expenses               Expense[]
  deviceTokens           DeviceToken[]
  notificationPreference NotificationPreference?
  pushNotificationLogs     PushNotificationLog[]
  restaurantMemberships    RestaurantMember[]      @relation("RestaurantMember")
  restaurantInvites        RestaurantMember[]      @relation("RestaurantInviter")
  orderStatusHistoryChanges OrderStatusHistory[]
  vendorRatingsReceived    VendorRating[]          @relation("VendorRatings")
  vendorRatingsGiven       VendorRating[]          @relation("OwnerVendorRatings")
  engineerRatingsReceived  EngineerRating[]        @relation("EngineerRatings")
  engineerRatingsGiven     EngineerRating[]        @relation("OwnerEngineerRatings")
  vendorStats              VendorStats?            @relation("VendorStats")
  engineerStats            EngineerStats?          @relation("EngineerStats")
  cashbookEntries          CashbookEntry[]
  vendorLedger             VendorLedger[]
  staff                    Staff[]
  supportTickets           SupportTicket[]       @relation("SupportTicketOwner")
  supportTicketThreads     SupportTicketThread[] @relation("SupportTicketThreadUser")
  partRequestsAsEngineer   PartRequest[]         @relation("EngineerPartRequests")
  partRequestsAsAdmin      PartRequest[]         @relation("AdminPartRequests")
  marketplaceProducts      MarketplaceProduct[]  @relation("MarketplaceProductCreator")

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ========================================
// B) PROFILES
// ========================================

model OwnerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorProfile {
  id                 String                    @id @default(cuid())
  userId             String                    @unique
  approvalStatus     VendorApprovalStatus      @default(PENDING)
  approvalNote       String?                   @db.Text
  rejectionReason    String?                   @db.Text // Mandatory when approvalStatus is REJECTED
  subscriptionStatus VendorSubscriptionStatus?
  trialEndsAt        DateTime?
  activeUntil        DateTime?
  createdAt          DateTime                  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorCoverage {
  id           String       @id @default(cuid())
  vendorId     String       @unique
  coverageType CoverageType
  cities       Json?
  pincodes     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model EngineerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  city      String?
  skills    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========================================
// C) NOTIFICATIONS
// ========================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushLogs PushNotificationLog[]

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

// ========================================
// D) CATALOG
// ========================================

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  subCategories        SubCategory[]
  serviceItems         ServiceItem[]
  partItems            PartItem[]
  restaurantCategories RestaurantCategory[]
  marketplaceProducts  MarketplaceProduct[]
  vendorProducts       VendorProduct[]       // Legacy relation for migration
  equipment            Equipment[]

  @@index([isActive])
}

model SubCategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceItems ServiceItem[]
  partItems    PartItem[]
  equipment    Equipment[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model ServiceItem {
  id            String    @id @default(cuid())
  categoryId    String
  subCategoryId String?
  name          String
  description   String?
  price         Int // in paise (1 INR = 100 paise)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory  SubCategory?         @relation(fields: [subCategoryId], references: [id])
  cartItems    CartItem[]
  bookingItems ServiceBookingItem[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isActive])
}

model PartItem {
  id            String    @id @default(cuid())
  categoryId    String
  subCategoryId String?
  name          String
  description   String?
  price         Int // in paise
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory  SubCategory?         @relation(fields: [subCategoryId], references: [id])
  cartItems    CartItem[]
  bookingItems ServiceBookingItem[]
  inventory    WarehouseInventory?
  jobPartsUsed JobPartUsed[]
  partRequests PartRequest[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isActive])
}

// ========================================
// E) OWNER RESTAURANT
// ========================================

model Restaurant {
  id                  String           @id @default(cuid())
  ownerId             String
  name                String
  address             String
  city                String
  pincode             String?
  restaurantImageUrl  String?
  fssaiNumber         String?
  fssaiCertificateUrl String?
  status              RestaurantStatus @default(PENDING)
  rejectionReason     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  owner             User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members           RestaurantMember[]
  categories        RestaurantCategory[]
  categoryRequests  CategoryRequest[]
  carts             Cart[]
  serviceBookings   ServiceBooking[]
  marketplaceOrders MarketplaceOrder[]
  equipments        Equipment[]
  amcSubscriptions  AMCSubscription[]
  expenses          Expense[]
  vendorRatings     VendorRating[]
  engineerRatings   EngineerRating[]
  cashbookEntries   CashbookEntry[]
  vendorLedger      VendorLedger[]
  staff             Staff[]
  staffAttendance   StaffAttendance[]
  staffSalaries     StaffSalary[]
  supportTickets    SupportTicket[]

  @@index([ownerId])
  @@index([status])
  @@index([fssaiNumber])
}

model RestaurantMember {
  id              String         @id @default(cuid())
  restaurantId    String
  userId          String
  role            RestaurantRole
  invitedBy       String
  inviteToken     String?        @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime       @default(now())
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation("RestaurantMember", fields: [userId], references: [id], onDelete: Cascade)
  inviter    User       @relation("RestaurantInviter", fields: [invitedBy], references: [id])

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
  @@index([invitedBy])
  @@index([inviteToken])
}

model RestaurantCategory {
  id           String @id @default(cuid())
  restaurantId String
  categoryId   String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, categoryId])
  @@index([restaurantId])
  @@index([categoryId])
}

model CategoryRequest {
  id              String                @id @default(cuid())
  ownerId         String
  restaurantId    String?
  requestedName   String
  description     String?
  reason          String?
  status          CategoryRequestStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime              @default(now())

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([ownerId])
  @@index([status])
}

// ========================================
// F) CART + BOOKING
// ========================================

model Cart {
  id           String     @id @default(cuid())
  ownerId      String
  restaurantId String
  status       CartStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@unique([ownerId, restaurantId, status])
  @@index([ownerId])
  @@index([restaurantId])
}

model CartItem {
  id            String       @id @default(cuid())
  cartId        String
  itemType      CartItemType
  serviceItemId String?
  partItemId    String?
  qty           Int
  priceSnapshot Int
  createdAt     DateTime     @default(now())

  cart        Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem? @relation(fields: [serviceItemId], references: [id])
  partItem    PartItem?    @relation(fields: [partItemId], references: [id])

  @@index([cartId])
}

model ServiceBooking {
  id                     String               @id @default(cuid())
  ownerId                String
  restaurantId           String
  equipmentId            String?              // Link to specific equipment being serviced
  slotStartDateTime      DateTime?
  slotEndDateTime        DateTime?
  adminAdjustedSlotStart DateTime?
  adminAdjustedSlotEnd   DateTime?
  status                 ServiceBookingStatus @default(DRAFT)
  totalAmount            Int
  problemDescription     String?              @db.Text // Description of the issue/problem
  problemImages          Json?                // Array of problem image URLs
  cancellationReason     String?              @db.Text // Mandatory when status is CANCELLED
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  equipment           Equipment?           @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  items               ServiceBookingItem[]
  paymentProof        PaymentProof?
  engineerAssignments EngineerAssignment[]
  amcUsage            AMCServiceUse[]
  stockMovements      StockMovement[]
  engineerRatings     EngineerRating[]

  @@index([ownerId])
  @@index([restaurantId])
  @@index([equipmentId])
  @@index([status])
  @@index([slotStartDateTime])
}

model ServiceBookingItem {
  id            String       @id @default(cuid())
  bookingId     String
  itemType      CartItemType
  serviceItemId String?
  partItemId    String?
  qty           Int
  priceSnapshot Int

  booking     ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem?   @relation(fields: [serviceItemId], references: [id])
  partItem    PartItem?      @relation(fields: [partItemId], references: [id])

  @@index([bookingId])
}

model PaymentProof {
  id              String             @id @default(cuid())
  bookingId       String             @unique
  ownerId         String
  screenshotUrl   String
  status          PaymentProofStatus @default(UPLOADED)
  adminNote       String?            @db.Text
  rejectionReason String?            @db.Text // Mandatory when status is REJECTED
  createdAt       DateTime           @default(now())
  verifiedAt      DateTime?

  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
}

model EngineerAssignment {
  id               String                   @id @default(cuid())
  bookingId        String
  engineerId       String
  status           EngineerAssignmentStatus @default(PENDING)
  assignedAt       DateTime                 @default(now())
  respondedAt      DateTime?
  completedAt      DateTime?
  rejectionReason  String?                  @db.Text // Mandatory when status is REJECTED
  commissionAmount Int?                     // Commission in paise (earned when completed)
  commissionRate   Int                      @default(20) // Commission percentage (default 20%)

  booking      ServiceBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  engineer     User             @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  workLog      EngineerWorkLog?
  payout       Payout?
  rating       EngineerRating?
  partRequests PartRequest[]

  @@unique([bookingId, engineerId])
  @@index([bookingId])
  @@index([engineerId])
  @@index([status])
}

model EngineerWorkLog {
  id               String    @id @default(cuid())
  assignmentId     String    @unique
  completionNote   String    @db.Text
  proofImageUrls   Json? // Array of image URLs (max 5)
  startedAt        DateTime? // When engineer started work
  completedAt      DateTime  @default(now()) // When work was completed
  timeSpentSeconds Int? // Time spent in seconds (from timer)
  partsUsedNames   Json? // Array of part names used (for display)
  workNotes        String?   @db.Text // Additional work notes
  createdAt        DateTime  @default(now())

  assignment EngineerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  partsUsed  JobPartUsed[]
}

// Parts used during job completion
model JobPartUsed {
  id           String   @id @default(cuid())
  workLogId    String
  partItemId   String
  qty          Int
  priceSnapshot Int     // Price at time of use (in paise)
  createdAt    DateTime @default(now())

  workLog  EngineerWorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  partItem PartItem        @relation(fields: [partItemId], references: [id])

  @@index([workLogId])
  @@index([partItemId])
}

// ========================================
// G) MARKETPLACE
// ========================================

// Admin-controlled master product catalog
model MarketplaceProduct {
  id          String    @id @default(cuid())
  name        String
  imageUrl    String?
  categoryId  String?
  unit        String    // kg, ltr, piece, etc.
  description String?   @db.Text  // Admin can provide default description
  isActive    Boolean   @default(true)
  createdBy   String    // Admin user ID
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category       Category?       @relation(fields: [categoryId], references: [id])
  creator        User            @relation("MarketplaceProductCreator", fields: [createdBy], references: [id])
  vendorProducts VendorProduct[]

  @@index([isActive])
  @@index([categoryId])
  @@index([createdBy])
}

// Vendor-controlled pricing for admin products
model VendorProduct {
  id            String    @id @default(cuid())
  vendorId      String
  productId     String?   // FK to MarketplaceProduct (nullable for migration)
  // Legacy fields - kept for migration, to be removed later
  name          String?
  categoryId    String?
  unit          String?
  imageUrl      String?
  // End legacy fields
  price         Int       // in paise (vendor sets this)
  description   String?   @db.Text  // Vendor can customize description
  stockQuantity Int       @default(0)
  deliveryTime  String?   // e.g., "2-3 days", "Same day"
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  vendor     User                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product    MarketplaceProduct?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category?              @relation(fields: [categoryId], references: [id])
  orderItems MarketplaceOrderItem[]

  @@index([vendorId])
  @@index([productId])
  @@index([isActive])
  @@index([categoryId])
}

model MarketplaceOrder {
  id                   String                 @id @default(cuid())
  ownerId              String
  vendorId             String
  restaurantId         String
  status               MarketplaceOrderStatus @default(PLACED)
  totalAmount          Int
  statusNotes          String?                @db.Text
  cancellationReason   String?                @db.Text // Mandatory when status is CANCELLED
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  statusUpdatedAt      DateTime               @default(now())

  owner         User                   @relation("OwnerOrders", fields: [ownerId], references: [id], onDelete: Cascade)
  vendor        User                   @relation("VendorOrders", fields: [vendorId], references: [id], onDelete: Cascade)
  restaurant    Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         MarketplaceOrderItem[]
  statusHistory OrderStatusHistory[]
  rating        VendorRating?

  @@index([ownerId])
  @@index([vendorId])
  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
}

model MarketplaceOrderItem {
  id              String @id @default(cuid())
  orderId         String
  vendorProductId String
  qty             Int
  priceSnapshot   Int

  order   MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product VendorProduct    @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusHistory {
  id          String                 @id @default(cuid())
  orderId     String
  oldStatus   MarketplaceOrderStatus?
  newStatus   MarketplaceOrderStatus
  notes       String?                @db.Text
  changedBy   String
  createdAt   DateTime               @default(now())

  order      MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User          @relation(fields: [changedBy], references: [id])

  @@index([orderId])
  @@index([changedBy])
  @@index([createdAt])
}

// ========================================
// H) AUDIT LOG
// ========================================

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  metaJson    String?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([createdAt])
}

// ========================================
// I) PAYMENT SETTINGS
// ========================================

model PaymentSettings {
  id                String   @id @default(cuid())
  qrCodeImageUrl    String   @db.Text // UPI QR code image URL
  upiId             String // UPI ID (e.g., merchant@upi)
  accountHolderName String // Business name
  instructions      String?  @db.Text // Payment instructions for customers
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
}

// ========================================
// J) ENGINEER PAYOUTS
// ========================================

model Payout {
  id           String       @id @default(cuid())
  assignmentId String       @unique
  engineerId   String
  amount       Int // Payout amount in paise
  status       PayoutStatus @default(PENDING)
  paidAt       DateTime?
  paymentNote  String?      @db.Text // Admin notes about payment
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignment EngineerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  engineer   User               @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@index([engineerId])
  @@index([status])
  @@index([createdAt])
}

// ========================================
// K) EQUIPMENT MANAGEMENT
// ========================================

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum AMCDuration {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AMCSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum StockMovementType {
  INWARD_PURCHASE
  INWARD_RETURN
  OUTWARD_USAGE
  OUTWARD_WASTAGE
  ADJUSTMENT
}

enum ExpenseCategory {
  FOOD
  UTILITIES
  SALARIES
  MAINTENANCE
  RENT
  SUPPLIES
  MARKETING
  TRANSPORT
  OTHER
}

// ========================================
// K) EQUIPMENT (Uses Category/SubCategory from Catalog)
// ========================================

model Equipment {
  id              String          @id @default(cuid())
  ownerId         String
  restaurantId    String
  categoryId      String?         // Link to Category
  subCategoryId   String?         // Link to SubCategory
  name            String          // User-given label/nickname
  brand           String?         // Specific brand
  model           String?         // Model number
  purchaseDate    DateTime
  warrantyEndDate DateTime?
  serialNumber    String?
  installLocation String?         // Where in the kitchen/restaurant
  billImageUrl    String?
  warrantyCardUrl String?
  photoUrls       Json?           // Array of equipment photo URLs (max 5)
  status          EquipmentStatus @default(AVAILABLE)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory     SubCategory?      @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  amcSubscription AMCSubscription[]
  serviceBookings ServiceBooking[]  // Service history for this equipment

  @@index([ownerId])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([status])
  @@index([warrantyEndDate])
}

// ========================================
// L) AMC (ANNUAL MAINTENANCE CONTRACT)
// ========================================

model AMCPlan {
  id           String      @id @default(cuid())
  name         String      @unique
  description  String?     @db.Text
  duration     AMCDuration
  price        Int // in paise
  serviceLimit Int // Number of services included
  featuresJson Json? // Array of features
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  subscriptions AMCSubscription[]

  @@index([isActive])
}

model AMCSubscription {
  id              String                @id @default(cuid())
  equipmentId     String
  ownerId         String
  restaurantId    String
  planId          String? // Optional: null if custom plan, set if using admin template
  // Custom Plan Fields (owner-defined)
  planName        String?
  planDescription String?               @db.Text
  duration        AMCDuration
  serviceLimit    Int
  featuresJson    Json? // Array of feature strings
  // Subscription Details
  startDate       DateTime
  endDate         DateTime
  status          AMCSubscriptionStatus @default(ACTIVE)
  autoRenew       Boolean               @default(false)
  servicesUsed    Int                   @default(0)
  totalAmount     Int // Cost in paise (owner can set their own pricing)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  cancelledAt     DateTime?

  equipment  Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
