// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========================================
// ENUMS
// ========================================

enum Role {
  ADMIN
  OWNER
  VENDOR
  ENGINEER
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OwnerApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RestaurantDeletionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentProofStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum ServiceBookingStatus {
  DRAFT
  SLOT_SELECTED
  PAYMENT_UPLOADED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  ENGINEER_ASSIGNED
  ACCEPTED_BY_ENGINEER
  IN_PROGRESS // Engineer has started work
  REJECTED_BY_ENGINEER
  COMPLETED
  CANCELLED
}

enum EngineerAssignmentStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS // Engineer has started work
  REJECTED
  COMPLETED
}

enum VendorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorSubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  BLOCKED
}

enum VendorSubscriptionRequestStatus {
  REQUESTED
  PRICE_SENT
  PAYMENT_UPLOADED
  PAYMENT_REJECTED
  ACTIVATED
}

enum VendorRevenueModel {
  SUBSCRIPTION
  COMMISSION
}

enum PayoutMethod {
  COMMISSION
  SALARY
}

enum VendorCommissionCollectionStatus {
  REQUESTED
  PAYMENT_UPLOADED
  PAYMENT_REJECTED
  VERIFIED
}

enum MarketplaceOrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MarketplacePaymentStatus {
  PENDING // owner uploaded screenshot, waiting vendor verification
  VERIFIED // vendor verified, order auto-created
  REJECTED // vendor rejected, owner can re-upload
  REFUNDED // Razorpay advance refunded (order-creation failure or cancellation)
}

enum CartItemType {
  SERVICE
  PART
}

enum CartStatus {
  DRAFT
  SUBMITTED
  ARCHIVED
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum CoverageType {
  CITY_WIDE
  PINCODE_WISE
}

enum VendorLocationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RestaurantRole {
  OWNER
  MANAGER
  ACCOUNTANT
  VIEWER
}

enum NotificationType {
  BOOKING
  PAYMENT
  ORDER
  AMC
  EQUIPMENT
  SYSTEM
  ANNOUNCEMENT
}

enum OTPPurpose {
  LOGIN
  REGISTRATION
  PASSWORD_RESET
  PHONE_VERIFICATION
  BOOKING_CONFIRMATION
  CANDIDATE_VERIFICATION
}

enum EmailCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  CANDIDATE_VERIFICATION
}

enum SMSStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum KhatabookSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

enum KhatabookTransactionType {
  BOOKING_REVENUE
  MARKETPLACE_ORDER
  EXPENSE
  ENGINEER_PAYOUT
  AMC_REVENUE
}

enum RatingCategory {
  PRODUCT_QUALITY
  DELIVERY_TIME
  CUSTOMER_SERVICE
  VALUE_FOR_MONEY
  PACKAGING
}

enum EngineerRatingCategory {
  PROFESSIONALISM
  TECHNICAL_SKILL
  COMMUNICATION
  PUNCTUALITY
  PROBLEM_SOLVING
}

enum PriceUnlockStatus {
  PENDING
  COUNTERED // Owner countered admin's unlocked price, awaiting admin response
  UNLOCKED
  DECLINED
}

enum PaymentInstallmentType {
  FULL // Regular, non-negotiated orders - one payment for the whole amount
  ADVANCE // 30% paid when a negotiated quote is confirmed
  FINAL // Remaining balance paid once the order is delivered
}

// ========================================
// A) AUTH
// ========================================

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  phone                  String?
  firebaseUid            String?   @unique
  passwordHash           String
  role                   Role
  emailVerified          Boolean   @default(false)
  isActive               Boolean   @default(true)
  // Engineer's own "available for new jobs" toggle. Deliberately separate
  // from isActive (which is the admin-controlled account enable/disable
  // flag) — they used to be the same field, which meant an engineer
  // marking themselves briefly unavailable could lock themselves out of
  // login and get silently skipped by payroll runs.
  isAvailable            Boolean   @default(true)
  // Per-owner discount override for service/parts bookings (percent, 0-100).
  // Null means "use PlatformSettings.defaultBookingDiscountPercent".
  serviceDiscountPercent Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  // Relations
  sessions                      Session[]
  ownerProfile                  OwnerProfile?
  vendorProfile                 VendorProfile?
  vendorCoverage                VendorCoverage?
  engineerProfile               EngineerProfile?
  notifications                 Notification[]
  restaurants                   Restaurant[]
  categoryRequests              CategoryRequest[]
  carts                         Cart[]
  serviceBookings               ServiceBooking[]
  paymentProofs                 PaymentProof[]
  engineerAssignments           EngineerAssignment[]
  vendorProducts                VendorProduct[]
  marketplaceOrders             MarketplaceOrder[]           @relation("OwnerOrders")
  vendorOrders                  MarketplaceOrder[]           @relation("VendorOrders")
  auditLogs                     AuditLog[]
  payouts                       Payout[]
  equipments                    Equipment[]
  amcSubscriptions              AMCSubscription[]
  stockMovements                StockMovement[]
  expenses                      Expense[]
  deviceTokens                  DeviceToken[]
  notificationPreference        NotificationPreference?
  pushNotificationLogs          PushNotificationLog[]
  restaurantMemberships         RestaurantMember[]           @relation("RestaurantMember")
  restaurantInvites             RestaurantMember[]           @relation("RestaurantInviter")
  orderStatusHistoryChanges     OrderStatusHistory[]
  vendorRatingsReceived         VendorRating[]               @relation("VendorRatings")
  vendorRatingsGiven            VendorRating[]               @relation("OwnerVendorRatings")
  engineerRatingsReceived       EngineerRating[]             @relation("EngineerRatings")
  engineerRatingsGiven          EngineerRating[]             @relation("OwnerEngineerRatings")
  vendorStats                   VendorStats?                 @relation("VendorStats")
  engineerStats                 EngineerStats?               @relation("EngineerStats")
  cashbookEntries               CashbookEntry[]
  vendorLedger                  VendorLedger[]
  staff                         Staff[]
  supportTickets                SupportTicket[]              @relation("SupportTicketOwner")
  supportTicketThreads          SupportTicketThread[]        @relation("SupportTicketThreadUser")
  partRequestsAsEngineer        PartRequest[]                @relation("EngineerPartRequests")
  partRequestsAsAdmin           PartRequest[]                @relation("AdminPartRequests")
  marketplaceProducts           MarketplaceProduct[]         @relation("MarketplaceProductCreator")
  vendorCategories              VendorCategorySelection[]
  vendorLocationRequests        VendorLocationRequest[]
  amcRequests                   AMCRequest[]
  amcSurveys                    AMCSiteSurvey[]              @relation("EngineerSurveys")
  amcContracts                  AMCContract[]                @relation("OwnerContracts")
  amcScheduledVisits            AMCScheduledVisit[]          @relation("EngineerVisits")
  amcBreakdownRequests          AMCBreakdownRequest[]        @relation("OwnerBreakdowns")
  amcPayments                   AMCPayment[]                 @relation("OwnerAMCPayments")
  amcPaymentsVerified           AMCPayment[]                 @relation("AdminVerifiedPayments")
  vendorSubscriptionRequests    VendorSubscriptionRequest[]  @relation("VendorSubscriptionRequests")
  vendorSubPriceSent            VendorSubscriptionRequest[]  @relation("AdminPriceSentSubscriptions")
  vendorSubVerified             VendorSubscriptionRequest[]  @relation("AdminVerifiedSubscriptions")
  vendorCommissions             VendorCommission[]           @relation("VendorCommissions")
  commissionCollections         VendorCommissionCollection[] @relation("VendorCommissionCollections")
  commissionCollectionsVerified VendorCommissionCollection[] @relation("AdminVerifiedCommissionCollections")
  marketplaceCarts              MarketplaceCart[]            @relation("MarketplaceCarts")
  ownerPayments                 MarketplacePayment[]         @relation("OwnerPayments")
  vendorPayments                MarketplacePayment[]         @relation("VendorPayments")
  priceUnlockRequests           PriceUnlockRequest[]         @relation("OwnerPriceUnlocks")
  salaryPayouts                 SalaryPayout[]
  recentlyViewedProducts        RecentlyViewedProduct[]
  bookingOffersCreated          BookingOffer[]
  bookingOfferRedemptions       BookingOfferRedemption[]
  adminBookings                 ServiceBooking[]             @relation("AdminBookings")
  candidateProfile              Candidate?
  candidateNotes                CandidateNote[]
  trainingAttendances           TrainingAttendance[]
  restaurantDeletionRequests    RestaurantDeletionRequest[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ========================================
// B) PROFILES
// ========================================

model OwnerProfile {
  id              String              @id @default(cuid())
  userId          String              @unique
  approvalStatus  OwnerApprovalStatus @default(PENDING)
  rejectionReason String?             @db.Text
  approvedAt      DateTime?
  createdAt       DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalStatus])
}

model VendorProfile {
  id                 String                    @id @default(cuid())
  userId             String                    @unique
  city               String?
  state              String?
  approvalStatus     VendorApprovalStatus      @default(PENDING)
  approvalNote       String?                   @db.Text
  rejectionReason    String?                   @db.Text // Mandatory when approvalStatus is REJECTED
  subscriptionStatus VendorSubscriptionStatus?
  trialEndsAt        DateTime?
  activeUntil        DateTime?
  isSystemVendor     Boolean                   @default(false)
  revenueModel       VendorRevenueModel        @default(SUBSCRIPTION)
  commissionRate     Int? // percentage (e.g. 10 = 10%)
  paymentQrCodeUrl   String?                   @db.Text
  paymentUpiId       String?
  paymentAccountName String?
  createdAt          DateTime                  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorCoverage {
  id           String       @id @default(cuid())
  vendorId     String       @unique
  coverageType CoverageType
  cities       Json?
  pincodes     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model EngineerProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  city           String?
  skills         String?
  payoutMethod   PayoutMethod @default(COMMISSION)
  commissionRate Int          @default(20) // percentage, used when COMMISSION
  monthlySalary  Int? // Rupees, used when SALARY
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========================================
// C) NOTIFICATIONS
// ========================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushLogs PushNotificationLog[]

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

// ========================================
// D) CATALOG
// ========================================

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  subCategories             SubCategory[]
  serviceItems              ServiceItem[]
  partItems                 PartItem[]
  restaurantCategories      RestaurantCategory[]
  equipment                 Equipment[]
  bookingOffers             BookingOffer[]
  // Legacy marketplace relation - to be removed after migration
  legacyMarketplaceProducts MarketplaceProduct[]

  @@index([isActive])
}

model SubCategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  imageUrl   String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceItems ServiceItem[]
  partItems    PartItem[]
  equipment    Equipment[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model ServiceItem {
  id            String    @id @default(cuid())
  categoryId    String
  subCategoryId String?
  name          String
  description   String?
  price         Int // in rupees
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory  SubCategory?         @relation(fields: [subCategoryId], references: [id])
  cartItems    CartItem[]
  bookingItems ServiceBookingItem[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isActive])
}

model PartItem {
  id            String    @id @default(cuid())
  categoryId    String
  subCategoryId String?
  name          String
  description   String?
  imageUrl      String?
  price         Int // in rupees
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory  SubCategory?         @relation(fields: [subCategoryId], references: [id])
  cartItems    CartItem[]
  bookingItems ServiceBookingItem[]
  inventory    WarehouseInventory?
  jobPartsUsed JobPartUsed[]
  partRequests PartRequest[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isActive])
}

// ========================================
// E) OWNER RESTAURANT
// ========================================

model Restaurant {
  id                  String           @id @default(cuid())
  ownerId             String
  name                String
  address             String
  city                String
  pincode             String?
  restaurantImageUrl  String?
  fssaiNumber         String?
  fssaiCertificateUrl String?
  outletType          String?
  status              RestaurantStatus @default(PENDING)
  rejectionReason     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  owner               User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members             RestaurantMember[]
  categories          RestaurantCategory[]
  categoryRequests    CategoryRequest[]
  carts               Cart[]
  serviceBookings     ServiceBooking[]
  marketplaceOrders   MarketplaceOrder[]
  marketplaceCarts    MarketplaceCart[]
  marketplacePayments MarketplacePayment[]
  equipments          Equipment[]
  amcSubscriptions    AMCSubscription[]
  expenses            Expense[]
  vendorRatings       VendorRating[]
  engineerRatings     EngineerRating[]
  cashbookEntries     CashbookEntry[]
  vendorLedger        VendorLedger[]
  staff               Staff[]
  staffAttendance     StaffAttendance[]
  staffSalaries       StaffSalary[]
  supportTickets      SupportTicket[]
  amcRequests         AMCRequest[]
  amcContracts        AMCContract[]
  priceUnlockRequests PriceUnlockRequest[]
  deletionRequests    RestaurantDeletionRequest[]

  @@index([ownerId])
  @@index([status])
  @@index([fssaiNumber])
}

model RestaurantMember {
  id              String         @id @default(cuid())
  restaurantId    String
  userId          String
  role            RestaurantRole
  invitedBy       String
  inviteToken     String?        @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime       @default(now())
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation("RestaurantMember", fields: [userId], references: [id], onDelete: Cascade)
  inviter    User       @relation("RestaurantInviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
  @@index([invitedBy])
  @@index([inviteToken])
}

model RestaurantCategory {
  id           String @id @default(cuid())
  restaurantId String
  categoryId   String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, categoryId])
  @@index([restaurantId])
  @@index([categoryId])
}

model CategoryRequest {
  id              String                @id @default(cuid())
  ownerId         String
  restaurantId    String?
  requestedName   String
  description     String?
  reason          String?
  status          CategoryRequestStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime              @default(now())

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([ownerId])
  @@index([status])
}

model RestaurantDeletionRequest {
  id              String                   @id @default(cuid())
  restaurantId    String?
  restaurantName  String
  ownerId         String
  reason          String                   @db.Text
  status          RestaurantDeletionStatus @default(PENDING)
  rejectionReason String?                  @db.Text
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime                 @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([ownerId])
  @@index([status])
}

// ========================================
// F) CART + BOOKING
// ========================================

model Cart {
  id           String     @id @default(cuid())
  ownerId      String
  restaurantId String
  status       CartStatus @default(DRAFT)
  promoCode    String? // owner-entered code, validated + consumed at booking creation
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@unique([ownerId, restaurantId, status])
  @@index([ownerId])
  @@index([restaurantId])
}

model CartItem {
  id            String       @id @default(cuid())
  cartId        String
  itemType      CartItemType
  serviceItemId String?
  partItemId    String?
  qty           Int
  priceSnapshot Int
  createdAt     DateTime     @default(now())

  cart        Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem? @relation(fields: [serviceItemId], references: [id])
  partItem    PartItem?    @relation(fields: [partItemId], references: [id])

  @@index([cartId])
}

model ServiceBooking {
  id                     String               @id @default(cuid())
  ownerId                String
  restaurantId           String
  equipmentId            String? // Link to specific equipment being serviced
  slotStartDateTime      DateTime?
  slotEndDateTime        DateTime?
  adminAdjustedSlotStart DateTime?
  adminAdjustedSlotEnd   DateTime?
  status                 ServiceBookingStatus @default(DRAFT)
  totalAmount            Int
  discountPercent        Int                  @default(0) // Discount % applied, snapshotted at booking time
  discountAmount         Int                  @default(0) // Discount amount in rupees, snapshotted at booking time
  discountSource         String? // Human-readable reason, e.g. "First Booking Offer: Welcome20", "Custom rate", "Platform default"
  gstAmount              Int                  @default(0) // GST (18%) amount
  tipAmount              Int                  @default(0) // Tip amount
  problemDescription     String?              @db.Text // Description of the issue/problem
  problemImages          Json? // Array of problem image URLs
  cancellationReason     String?              @db.Text // Mandatory when status is CANCELLED
  isDirectBooking        Boolean              @default(false)
  createdByAdminId       String?
  adminNotes             String?              @db.Text
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  owner               User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant          Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  equipment           Equipment?              @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  createdByAdmin      User?                   @relation("AdminBookings", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  items               ServiceBookingItem[]
  paymentProof        PaymentProof?
  engineerAssignments EngineerAssignment[]
  amcUsage            AMCServiceUse[]
  stockMovements      StockMovement[]
  engineerRatings     EngineerRating[]
  offerRedemption     BookingOfferRedemption?

  @@index([ownerId])
  @@index([restaurantId])
  @@index([equipmentId])
  @@index([status])
  @@index([slotStartDateTime])
}

model ServiceBookingItem {
  id            String       @id @default(cuid())
  bookingId     String
  itemType      CartItemType
  serviceItemId String?
  partItemId    String?
  qty           Int
  priceSnapshot Int

  booking     ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem?   @relation(fields: [serviceItemId], references: [id])
  partItem    PartItem?      @relation(fields: [partItemId], references: [id])

  @@index([bookingId])
}

model PaymentProof {
  id                String             @id @default(cuid())
  bookingId         String             @unique
  ownerId           String
  screenshotUrl     String?
  status            PaymentProofStatus @default(UPLOADED)
  adminNote         String?            @db.Text
  rejectionReason   String?            @db.Text // Mandatory when status is REJECTED
  paymentMethod     String             @default("SCREENSHOT") // "SCREENSHOT" or "RAZORPAY"
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  createdAt         DateTime           @default(now())
  verifiedAt        DateTime?

  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
}

model EngineerAssignment {
  id                  String                   @id @default(cuid())
  bookingId           String
  engineerId          String
  status              EngineerAssignmentStatus @default(PENDING)
  assignedAt          DateTime                 @default(now())
  respondedAt         DateTime?
  completedAt         DateTime?
  rejectionReason     String?                  @db.Text // Mandatory when status is REJECTED
  commissionAmount    Int? // Commission in rupees (earned when completed)
  commissionRate      Int                      @default(20) // Commission percentage (default 20%)
  servicePin          String? // 4-digit PIN for start/complete verification
  servicePinExpiresAt DateTime? // PIN expires in 10 minutes
  servicePinPurpose   String? // "START" or "COMPLETE"
  servicePinAttempts  Int                      @default(0) // Max 5 wrong attempts

  booking      ServiceBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  engineer     User             @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  workLog      EngineerWorkLog?
  payout       Payout?
  rating       EngineerRating?
  partRequests PartRequest[]

  @@unique([bookingId, engineerId])
  @@index([bookingId])
  @@index([engineerId])
  @@index([status])
}

model EngineerWorkLog {
  id               String    @id @default(cuid())
  assignmentId     String    @unique
  completionNote   String    @db.Text
  proofImageUrls   Json? // Array of image URLs (max 5)
  startedAt        DateTime? // When engineer started work
  completedAt      DateTime  @default(now()) // When work was completed
  timeSpentSeconds Int? // Time spent in seconds (from timer)
  partsUsedNames   Json? // Array of part names used (for display)
  workNotes        String?   @db.Text // Additional work notes
  createdAt        DateTime  @default(now())

  assignment EngineerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  partsUsed  JobPartUsed[]
}

// Parts used during job completion
model JobPartUsed {
  id            String   @id @default(cuid())
  workLogId     String
  partItemId    String
  qty           Int
  priceSnapshot Int // Price at time of use (in rupees)
  createdAt     DateTime @default(now())

  workLog  EngineerWorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  partItem PartItem        @relation(fields: [partItemId], references: [id])

  @@index([workLogId])
  @@index([partItemId])
}

// ========================================
// G) MARKETPLACE
// ========================================

// Marketplace-specific category hierarchy (Admin controlled)
model MarketplaceCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  imageUrl  String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete: non-null means hidden/removed

  subCategories    MarketplaceSubCategory[]
  products         MarketplaceProduct[]
  vendorCategories VendorCategorySelection[]

  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model MarketplaceSubCategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  slug       String
  imageUrl   String?
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? // Soft delete: non-null means hidden/removed

  category MarketplaceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products MarketplaceProduct[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
}

// Many-to-Many: Vendor selects categories they serve
model VendorCategorySelection {
  id         String   @id @default(cuid())
  vendorId   String
  categoryId String
  createdAt  DateTime @default(now())

  vendor   User                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category MarketplaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([vendorId, categoryId])
  @@index([vendorId])
  @@index([categoryId])
}

// Admin-controlled master product catalog
model MarketplaceProduct {
  id                       String    @id @default(cuid())
  marketplaceCategoryId    String? // New marketplace category
  marketplaceSubCategoryId String? // New marketplace subcategory
  name                     String
  imageUrl                 String?
  unit                     String // kg, ltr, piece, etc.
  description              String?   @db.Text // Admin default description
  isActive                 Boolean   @default(true)
  createdBy                String // Admin user ID
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?
  // Legacy field - to be removed after migration
  categoryId               String?

  marketplaceCategory    MarketplaceCategory?    @relation(fields: [marketplaceCategoryId], references: [id], onDelete: Cascade)
  marketplaceSubCategory MarketplaceSubCategory? @relation(fields: [marketplaceSubCategoryId], references: [id])
  creator                User                    @relation("MarketplaceProductCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  vendorProducts         VendorProduct[]
  legacyCategory         Category?               @relation(fields: [categoryId], references: [id])

  @@index([isActive])
  @@index([marketplaceCategoryId])
  @@index([marketplaceSubCategoryId])
  @@index([createdBy])
  @@index([categoryId])
}

// Vendor-controlled pricing for admin products
model VendorProduct {
  id            String    @id @default(cuid())
  vendorId      String
  productId     String? // FK to MarketplaceProduct
  // Legacy fields - kept for migration
  name          String?
  categoryId    String?
  unit          String?
  imageUrl      String?
  // End legacy fields
  price         Int // in rupees (vendor sets this)
  minOrderQty   Int       @default(1) // Minimum order quantity
  description   String?   @db.Text // Vendor can customize description
  stockQuantity Int       @default(0)
  deliveryTime  String? // e.g., "2-3 days", "Same day"
  isAvailable   Boolean   @default(true)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  priceOnRequest Boolean @default(false) // KNI Official Store only - hide price, show "Price on Request"

  vendor              User                    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product             MarketplaceProduct?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems          MarketplaceOrderItem[]
  cartItems           MarketplaceCartItem[]
  priceUnlockRequests PriceUnlockRequest[]
  recentlyViewed      RecentlyViewedProduct[]

  @@index([vendorId])
  @@index([productId])
  @@index([isActive])
  @@index([isAvailable])
  @@index([categoryId])
}

model PriceUnlockRequest {
  id                String            @id @default(cuid())
  ownerId           String
  restaurantId      String
  vendorProductId   String
  quantity          Int? // Owner can mention required quantity
  message           String?           @db.Text // Owner's message to admin
  status            PriceUnlockStatus @default(PENDING)
  unlockedPrice     Int? // Custom price set by admin (in rupees)
  ownerCounterPrice Int? // Owner's counter-offer (in rupees), set when status is COUNTERED
  validUntil        DateTime? // Price expiry date
  adminNote         String?           @db.Text // Admin's note to owner
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  owner      User          @relation("OwnerPriceUnlocks", fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    VendorProduct @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@unique([ownerId, restaurantId, vendorProductId])
  @@index([vendorProductId])
  @@index([status])
  @@index([restaurantId])
}

model MarketplaceOrder {
  id                   String                 @id @default(cuid())
  ownerId              String
  vendorId             String
  restaurantId         String
  status               MarketplaceOrderStatus @default(PLACED)
  totalAmount          Int
  deliveryAddress      String?                @db.Text
  notes                String?                @db.Text
  statusNotes          String?                @db.Text
  cancellationReason   String?                @db.Text // Mandatory when status is CANCELLED
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  statusUpdatedAt      DateTime               @default(now())

  owner            User                   @relation("OwnerOrders", fields: [ownerId], references: [id], onDelete: Cascade)
  vendor           User                   @relation("VendorOrders", fields: [vendorId], references: [id], onDelete: Cascade)
  restaurant       Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items            MarketplaceOrderItem[]
  statusHistory    OrderStatusHistory[]
  rating           VendorRating?
  vendorCommission VendorCommission?

  @@index([ownerId])
  @@index([vendorId])
  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
}

model MarketplacePayment {
  id                String                   @id @default(cuid())
  ownerId           String
  vendorId          String
  restaurantId      String
  totalAmount       Int // in rupees
  items             Json // [{productId, qty, priceSnapshot, name}]
  deliveryAddress   String?                  @db.Text
  notes             String?                  @db.Text
  screenshotUrl     String?                  @db.Text
  status            MarketplacePaymentStatus @default(PENDING)
  rejectionReason   String?                  @db.Text
  orderId           String? // Not unique: a negotiated order can have both an ADVANCE and a FINAL payment row
  installmentType   PaymentInstallmentType   @default(FULL)
  paymentMethod     String                   @default("SCREENSHOT") // "SCREENSHOT" or "RAZORPAY"
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  refundId          String? // Razorpay refund id, set once a refund succeeds
  refundedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  verifiedAt        DateTime?

  owner      User       @relation("OwnerPayments", fields: [ownerId], references: [id], onDelete: Cascade)
  vendor     User       @relation("VendorPayments", fields: [vendorId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model MarketplaceCart {
  id           String   @id @default(cuid())
  ownerId      String
  restaurantId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User                  @relation("MarketplaceCarts", fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MarketplaceCartItem[]

  @@unique([ownerId, restaurantId])
  @@index([ownerId])
  @@index([restaurantId])
}

model MarketplaceCartItem {
  id              String   @id @default(cuid())
  cartId          String
  vendorProductId String
  quantity        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cart    MarketplaceCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product VendorProduct   @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@unique([cartId, vendorProductId])
  @@index([cartId])
  @@index([vendorProductId])
}

model MarketplaceOrderItem {
  id              String @id @default(cuid())
  orderId         String
  vendorProductId String
  qty             Int
  priceSnapshot   Int

  order   MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product VendorProduct    @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String                  @id @default(cuid())
  orderId   String
  oldStatus MarketplaceOrderStatus?
  newStatus MarketplaceOrderStatus
  notes     String?                 @db.Text
  changedBy String
  createdAt DateTime                @default(now())

  order         MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User             @relation(fields: [changedBy], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([changedBy])
  @@index([createdAt])
}

// ========================================
// H) AUDIT LOG
// ========================================

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  metaJson    String?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([createdAt])
}

// ========================================
// I) PAYMENT SETTINGS
// ========================================

model PaymentSettings {
  id                String   @id @default(cuid())
  qrCodeImageUrl    String   @db.Text // UPI QR code image URL
  upiId             String // UPI ID (e.g., merchant@upi)
  accountHolderName String // Business name
  instructions      String?  @db.Text // Payment instructions for customers
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
}

enum BookingOfferType {
  FIRST_BOOKING // Only applies to an owner's first-ever (non-cancelled) ServiceBooking
  PROMOTIONAL // Applies to everyone, within the offer's date window
}

// Admin-managed discount campaigns for service/parts bookings. Multiple can
// be active at once; the highest applicable discount wins (see
// getEffectiveDiscount in src/server/pricing/discount.ts).
model BookingOffer {
  id              String           @id @default(cuid())
  name            String // e.g., "Welcome Offer", "Diwali Sale"
  type            BookingOfferType
  discountPercent Int
  startDate       DateTime? // null = starts immediately
  endDate         DateTime? // null = no end date (only ends via isActive=false)
  isActive        Boolean          @default(true) // admin can pause/end early without deleting

  code           String? @unique // if set, only applies when the owner enters this code - excluded from auto-apply
  categoryId     String? // if set, discount is computed only against this category's subtotal within the booking
  maxRedemptions Int? // null = unlimited total uses
  onePerOwner    Boolean @default(false) // restrict to one redemption per owner, regardless of maxRedemptions

  imageUrl    String? // promo image shown on the mobile/web home offer carousel
  description String? @db.Text // short promo text shown alongside the image
  sortOrder   Int     @default(0) // carousel display order, lower first

  category    Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  redemptions BookingOfferRedemption[]

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([categoryId])
  @@index([sortOrder])
}

// One row per booking that redeemed a BookingOffer - the source of truth for
// maxRedemptions / onePerOwner enforcement (counted, not a mutable counter
// field, so concurrent bookings can't race past the cap).
model BookingOfferRedemption {
  id        String   @id @default(cuid())
  offerId   String
  ownerId   String
  bookingId String   @unique
  createdAt DateTime @default(now())

  offer   BookingOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([ownerId])
}

// ========================================
// J) ENGINEER PAYOUTS
// ========================================

model Payout {
  id           String       @id @default(cuid())
  assignmentId String       @unique
  engineerId   String
  amount       Int // Payout amount in rupees
  status       PayoutStatus @default(PENDING)
  paidAt       DateTime?
  paymentNote  String?      @db.Text // Admin notes about payment
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignment EngineerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  engineer   User               @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@index([engineerId])
  @@index([status])
  @@index([createdAt])
}

// ========================================
// K) EQUIPMENT MANAGEMENT
// ========================================

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum AMCDuration {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum AMCSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AMCSource {
  INTERNAL
  EXTERNAL
}

enum StockMovementType {
  INWARD_PURCHASE
  INWARD_RETURN
  OUTWARD_USAGE
  OUTWARD_WASTAGE
  ADJUSTMENT
}

enum ExpenseCategory {
  FOOD
  UTILITIES
  SALARIES
  MAINTENANCE
  RENT
  SUPPLIES
  MARKETING
  TRANSPORT
  OTHER
}

// ========================================
// K) EQUIPMENT (Uses Category/SubCategory from Catalog)
// ========================================

model Equipment {
  id              String          @id @default(cuid())
  ownerId         String
  restaurantId    String
  categoryId      String? // Link to Category
  subCategoryId   String? // Link to SubCategory
  name            String // User-given label/nickname
  brand           String? // Specific brand
  model           String? // Model number
  purchaseDate    DateTime
  warrantyEndDate DateTime?
  serialNumber    String?
  installLocation String? // Where in the kitchen/restaurant
  billImageUrl    String?
  warrantyCardUrl String?
  photoUrls       Json? // Array of equipment photo URLs (max 5)
  status          EquipmentStatus @default(AVAILABLE)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory     SubCategory?      @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  amcSubscription AMCSubscription[]
  serviceBookings ServiceBooking[] // Service history for this equipment

  @@index([ownerId])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([status])
  @@index([warrantyEndDate])
}

// ========================================
// L) AMC (ANNUAL MAINTENANCE CONTRACT)
// ========================================

model AMCPlan {
  id           String      @id @default(cuid())
  name         String      @unique
  description  String?     @db.Text
  duration     AMCDuration
  price        Int // in paise
  serviceLimit Int // Number of services included
  featuresJson Json? // Array of features
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  subscriptions AMCSubscription[]

  @@index([isActive])
}

model AMCSubscription {
  id              String                @id @default(cuid())
  equipmentId     String
  ownerId         String
  restaurantId    String
  planId          String? // Optional: null if custom plan, set if using admin template
  // Custom Plan Fields (owner-defined)
  planName        String?
  planDescription String?               @db.Text
  duration        AMCDuration
  serviceLimit    Int
  featuresJson    Json? // Array of feature strings
  // Subscription Details
  startDate       DateTime
  endDate         DateTime
  status          AMCSubscriptionStatus @default(ACTIVE)
  autoRenew       Boolean               @default(false)
  servicesUsed    Int                   @default(0)
  totalAmount     Int // Cost in rupees (owner can set their own pricing)
  // Source tracking
  source          AMCSource             @default(INTERNAL)
  providerName    String? // External provider name (e.g., "Voltas", "Blue Star")
  providerContact String? // External provider phone/email
  contractNumber  String? // External contract/reference number
  documentUrl     String?               @db.Text // URL to uploaded contract document
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  cancelledAt     DateTime?

  equipment  Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  plan       AMCPlan?        @relation(fields: [planId], references: [id])
  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  usageLogs  AMCServiceUse[]

  @@index([ownerId])
  @@index([restaurantId])
  @@index([equipmentId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
  @@index([source])
}

model AMCServiceUse {
  id             String   @id @default(cuid())
  subscriptionId String
  bookingId      String?
  serviceDate    DateTime
  serviceType    String
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  subscription AMCSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  booking      ServiceBooking? @relation(fields: [bookingId], references: [id])

  @@index([subscriptionId])
  @@index([bookingId])
}

// ========================================
// L2) AMC REQUEST SYSTEM (New Professional AMC Flow)
// ========================================

model AMCRequest {
  id           String           @id @default(cuid())
  ownerId      String
  restaurantId String
  status       AMCRequestStatus @default(REQUESTED)

  // What owner selects
  equipmentCategories Json     @default("[]")
  kitchenType         String
  planType            String // BASIC / STANDARD / PREMIUM
  visitFrequency      String // MONTHLY / BI_MONTHLY / QUARTERLY
  preferredStartDate  DateTime
  notes               String?  @db.Text

  // Renewal link (if this request is a renewal of an existing contract)
  renewalOfContractId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant        Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  renewalOfContract AMCContract?   @relation("ContractRenewals", fields: [renewalOfContractId], references: [id])
  survey            AMCSiteSurvey?
  proposal          AMCProposal?
  payment           AMCPayment?

  @@index([ownerId])
  @@index([restaurantId])
  @@index([status])
  @@index([renewalOfContractId])
}

enum AMCRequestStatus {
  REQUESTED
  SURVEY_SCHEDULED
  SURVEY_COMPLETED
  PROPOSAL_SENT
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  PAYMENT_PENDING
  PAYMENT_UPLOADED
  CONTRACT_ACTIVE
  CANCELLED
}

// ========================================
// L3) AMC SITE SURVEY
// ========================================

model AMCSiteSurvey {
  id            String       @id @default(cuid())
  requestId     String       @unique
  engineerId    String
  scheduledDate DateTime
  completedDate DateTime?
  status        SurveyStatus @default(SCHEDULED)

  // Survey data (engineer fills after site visit)
  equipmentList    Json? // [{name, brand, model, age, condition, spareRisk, notes}]
  overallCondition String? // GOOD / AVERAGE / CRITICAL
  specialNotes     String? @db.Text
  photoUrls        Json?   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request  AMCRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  engineer User       @relation("EngineerSurveys", fields: [engineerId], references: [id], onDelete: Cascade)

  @@index([engineerId])
  @@index([status])
  @@index([scheduledDate])
}

enum SurveyStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ========================================
// L4) AMC PROPOSAL
// ========================================

model AMCProposal {
  id        String         @id @default(cuid())
  requestId String         @unique
  status    ProposalStatus @default(DRAFT)

  // Proposal details
  coveredEquipment    Json? // [{name, brand, model}]
  preventiveVisits    Int // e.g., 12 per year
  freeBreakdownVisits Int     @default(0)
  responseTimeSLA     String? // e.g., "4 hours"
  resolutionTimeSLA   String? // e.g., "24 hours"
  exclusions          Json?   @default("[]")
  sparePartsPolicy    String? @db.Text

  // Pricing (in rupees) - one price for the whole contractPeriod
  price          Int
  contractPeriod String @default("1 YEAR") // "1 YEAR" / "2 YEAR"

  // Negotiation (owner counters admin's price; latest round only, no thread)
  ownerCounterPrice   Int?
  ownerCounterMessage String? @db.Text
  adminNote           String? @db.Text

  // Approval tracking
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request  AMCRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  contract AMCContract?

  @@index([status])
}

enum ProposalStatus {
  DRAFT
  SENT
  COUNTERED // Owner countered admin's price, awaiting admin's revised proposal
  ACCEPTED
  REJECTED
}

// ========================================
// L5) AMC CONTRACT
// ========================================

model AMCContract {
  id           String  @id @default(cuid())
  proposalId   String? @unique
  requestId    String
  ownerId      String
  restaurantId String

  contractNumber String         @unique // e.g., "AMC-2026-001"
  status         ContractStatus @default(ACTIVE)

  // Contract terms (copied from proposal)
  coveredEquipment    Json?
  preventiveVisits    Int
  freeBreakdownVisits Int     @default(0)
  breakdownVisitsUsed Int     @default(0)
  responseTimeSLA     String?
  resolutionTimeSLA   String?

  // Dates & Billing
  startDate DateTime
  endDate   DateTime
  amount    Int // in rupees, for the whole contractPeriod

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal          AMCProposal?          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  owner             User                  @relation("OwnerContracts", fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant        Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  scheduledVisits   AMCScheduledVisit[]
  breakdownRequests AMCBreakdownRequest[]
  renewalRequests   AMCRequest[]          @relation("ContractRenewals")

  @@index([ownerId])
  @@index([restaurantId])
  @@index([status])
  @@index([endDate])
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  RENEWED
}

// ========================================
// L6) AMC SCHEDULED VISITS
// ========================================

model AMCScheduledVisit {
  id         String  @id @default(cuid())
  contractId String
  engineerId String?

  visitNumber   Int // 1, 2, 3... 12
  visitType     String      @default("PREVENTIVE") // PREVENTIVE / BREAKDOWN
  scheduledDate DateTime
  completedDate DateTime?
  status        VisitStatus @default(SCHEDULED)

  // Engineer work
  checklistJson Json? // [{item, checked, notes}]
  workNotes     String? @db.Text
  photoUrls     Json?   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract AMCContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  engineer User?       @relation("EngineerVisits", fields: [engineerId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([engineerId])
  @@index([status])
  @@index([scheduledDate])
}

enum VisitStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  MISSED
  RESCHEDULED
  CANCELLED
}

// ========================================
// L7) AMC BREAKDOWN REQUESTS
// ========================================

model AMCBreakdownRequest {
  id         String @id @default(cuid())
  contractId String
  ownerId    String

  equipmentName String
  problemDesc   String @db.Text
  urgency       String @default("MEDIUM") // LOW / MEDIUM / HIGH
  photoUrls     Json?  @default("[]")

  // System checks
  isCoveredByAMC  Boolean @default(true)
  freeVisitsUsed  Int     @default(0)
  freeVisitsTotal Int     @default(0)

  // Resolution
  status          BreakdownStatus @default(REQUESTED)
  assignedVisitId String?
  resolvedAt      DateTime?
  chargeAmount    Int? // in rupees, if chargeable

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract AMCContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
