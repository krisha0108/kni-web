// ========================================
// PART REQUESTS (Engineer requesting parts)
// ========================================

enum PartRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PartRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PartRequest {
  id              String              @id @default(cuid())
  engineerId      String
  partItemId      String
  assignmentId    String?             // Optional: linked to a specific job
  quantity        Int                 @default(1)
  priority        PartRequestPriority @default(MEDIUM)
  reason          String?             @db.Text
  status          PartRequestStatus   @default(PENDING)

  // Admin response
  adminId         String?             // Admin who processed the request
  adminNote       String?             @db.Text
  rejectionReason String?

  // Tracking
  approvedAt      DateTime?
  rejectedAt      DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  engineer        User                @relation("EngineerPartRequests", fields: [engineerId], references: [id])
  partItem        PartItem            @relation(fields: [partItemId], references: [id])
  assignment      EngineerAssignment? @relation(fields: [assignmentId], references: [id])
  admin           User?               @relation("AdminPartRequests", fields: [adminId], references: [id])

  @@index([engineerId])
  @@index([partItemId])
  @@index([assignmentId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}
