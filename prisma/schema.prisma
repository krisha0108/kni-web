// ========================================
// O) KHAYABOOK FINANCE LAYER
// ========================================

enum CashbookEntryType {
  CASH_IN
  CASH_OUT
  BANK_IN
  BANK_OUT
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

model CashbookEntry {
  id           String            @id @default(cuid())
  ownerId      String
  restaurantId String
  entryType    CashbookEntryType
  amount       Int // in rupees
  paymentMode  PaymentMode       @default(CASH)
  category     String? // Optional categorization
  description  String            @db.Text
  referenceNo  String? // Cheque/transaction reference
  entryDate    DateTime
  createdBy    String // User who created entry
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([restaurantId])
  @@index([entryType])
  @@index([entryDate])
  @@index([createdBy])
}

enum LedgerEntryType {
  PURCHASE // Vendor supplied goods/services
  PAYMENT // Payment made to vendor
  CREDIT_NOTE // Return or adjustment
  DEBIT_NOTE // Additional charges
}

model VendorLedger {
  id           String          @id @default(cuid())
  ownerId      String
  restaurantId String
  vendorName   String // Party/supplier name
  vendorPhone  String?
  vendorGST    String?
  entryType    LedgerEntryType
  amount       Int // in rupees
