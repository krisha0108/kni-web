  cityId    String
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city             ServiceCity             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  locationRequests VendorLocationRequest[]

  @@unique([cityId, name])
  @@index([cityId])
  @@index([isActive])
  @@index([sortOrder])
}

model VendorLocationRequest {
  id        String                      @id @default(cuid())
  vendorId  String
  areaId    String
  status    VendorLocationRequestStatus @default(PENDING)
  note      String?                     @db.Text
  adminNote String?                     @db.Text
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  vendor User        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  area   ServiceArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([vendorId, areaId])
  @@index([vendorId])
  @@index([areaId])
  @@index([status])
  @@index([createdAt])
}

// ========================================
// VENDOR SUBSCRIPTION REQUESTS
// ========================================

model VendorSubscriptionRequest {
  id                String                          @id @default(cuid())
  vendorId          String
  durationMonths    Int
  status            VendorSubscriptionRequestStatus @default(REQUESTED)
  price             Int?
  priceSentAt       DateTime?
  priceSentById     String?
  screenshotUrl     String?                         @db.Text
  paymentMethod     String                          @default("SCREENSHOT")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paymentUploadedAt DateTime?
  verifiedById      String?
  verifiedAt        DateTime?
  rejectionReason   String?                         @db.Text
  adminNote         String?                         @db.Text
  activatedAt       DateTime?
  activeUntil       DateTime?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  vendor      User  @relation("VendorSubscriptionRequests", fields: [vendorId], references: [id], onDelete: Cascade)
  priceSentBy User? @relation("AdminPriceSentSubscriptions", fields: [priceSentById], references: [id], onDelete: SetNull)
  verifiedBy  User? @relation("AdminVerifiedSubscriptions", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

// ========================================
// VENDOR COMMISSION SYSTEM
// ========================================

model VendorCommission {
  id               String   @id @default(cuid())
  orderId          String   @unique
  vendorId         String
  orderAmount      Int // total order amount
  commissionRate   Int // rate at time of calculation
  commissionAmount Int // calculated commission
  collectionId     String? // link to collection when collected
  createdAt        DateTime @default(now())

  order      MarketplaceOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor     User                        @relation("VendorCommissions", fields: [vendorId], references: [id], onDelete: Cascade)
  collection VendorCommissionCollection? @relation(fields: [collectionId], references: [id])

  @@index([vendorId])
  @@index([collectionId])
  @@index([createdAt])
}

model VendorCommissionCollection {
  id                String                           @id @default(cuid())
  vendorId          String
  totalAmount       Int // total commission to collect
  status            VendorCommissionCollectionStatus @default(REQUESTED)
  screenshotUrl     String?                          @db.Text
  paymentMethod     String                           @default("SCREENSHOT")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paymentUploadedAt DateTime?
  verifiedById      String?
  verifiedAt        DateTime?
  rejectionReason   String?                          @db.Text
  adminNote         String?                          @db.Text
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  vendor      User               @relation("VendorCommissionCollections", fields: [vendorId], references: [id], onDelete: Cascade)
  verifiedBy  User?              @relation("AdminVerifiedCommissionCollections", fields: [verifiedById], references: [id], onDelete: SetNull)
  commissions VendorCommission[]

  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

// ========================================
// SALARY PAYOUTS (Monthly salary tracking for engineers)
// ========================================

model SalaryPayout {
  id          String    @id @default(cuid())
  engineerId  String
  month       Int // 1-12
  year        Int // e.g. 2026
  amount      Int // Rupees
  status      String    @default("PENDING") // PENDING, PAID
  paidAt      DateTime?
  paymentNote String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  engineer User @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([engineerId, month, year])
  @@index([engineerId])
  @@index([status])
  @@index([year, month])
}

// ========================================
// LAUNCH PAD INQUIRIES (Lead Generation)
// ========================================

enum BusinessType {
  RESTAURANT
  CAFE
  CLOUD_KITCHEN
  QSR
  BAKERY
  CATERING
  OTHER
}

enum BudgetRange {
  UNDER_5L
  L5_TO_10L
  L10_TO_25L
  L25_TO_50L
  L50_TO_1CR
  ABOVE_1CR
}

enum LaunchTimeline {
  IMMEDIATELY
  WITHIN_1_MONTH
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
  WITHIN_1_YEAR
  JUST_EXPLORING
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ON_HOLD
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InquiryActivityType {
  EMAIL_SENT
  CALL_LOGGED
  STATUS_CHANGED
  PRIORITY_CHANGED
  NOTE_ADDED
  CUSTOMER_REPLY
  INQUIRY_CREATED
}

model LaunchPadInquiry {
  id             String          @id @default(cuid())
  name           String
  email          String
  phone          String
  city           String
  businessType   BusinessType
  businessName   String?
  budgetRange    BudgetRange?
  areaInSqFt     Int?
  timeline       LaunchTimeline?
  message        String?         @db.Text
  servicesNeeded String?         @db.Text // comma-separated
  source         String          @default("website")
  status         InquiryStatus   @default(NEW)
  priority       InquiryPriority @default(MEDIUM)
  assignedTo     String? // Plain text: person/team name
  followUpDate   DateTime?
  accessToken    String?         @unique // Token for public portal access
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  threads    LaunchPadInquiryThread[]
  activities LaunchPadActivityLog[]

  @@index([status])
  @@index([priority])
  @@index([businessType])
  @@index([email])
  @@index([createdAt])
}

model LaunchPadInquiryThread {
  id        String           @id @default(cuid())
  inquiryId String
  inquiry   LaunchPadInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  message   String           @db.Text
  subject   String?
  isAdmin   Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([inquiryId])
  @@index([createdAt])
}

model LaunchPadActivityLog {
  id          String              @id @default(cuid())
  inquiryId   String
  inquiry     LaunchPadInquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  type        InquiryActivityType
  description String              @db.Text
  metadata    String?             @db.Text // JSON string for extra data (duration, old/new values, etc.)
  performedBy String? // Admin name or "Customer"
  createdAt   DateTime            @default(now())

  @@index([inquiryId])
  @@index([type])
  @@index([createdAt])
}

// ========================================
// RECENTLY VIEWED PRODUCTS
// ========================================

model RecentlyViewedProduct {
  id              String   @id @default(cuid())
  userId          String
  vendorProductId String
  viewedAt        DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorProduct VendorProduct @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorProductId])
  @@index([userId, viewedAt])
  @@index([vendorProductId])
}

// ========================================
// RECRUITMENT & TECHNICIAN ONBOARDING CRM
// ========================================

enum RecruitmentPosition {
  TECHNICIAN_MECHANICAL
  TECHNICIAN_ELECTRICAL
  TECHNICIAN_REFRIGERATION
  TECHNICIAN_INDUCTION
  TECHNICIAN_COMMERCIAL_KITCHEN
}

enum CandidateStatus {
  NEW
  UNDER_REVIEW
  SHORTLISTED
  ON_HOLD
  REJECTED
  INTERVIEW_SCHEDULED
  TECHNICAL_EVALUATION
  APPROVED
  REGISTRATION_PAYMENT_PENDING
  REGISTERED_PARTNER
  TRAINING_PENDING
  ACTIVE_TECHNICIAN
}

enum CandidateActivityType {
  CANDIDATE_CREATED
  STATUS_CHANGED
  NOTE_ADDED
  RATING_UPDATED
  SMS_SENT
  EMAIL_SENT
  WHATSAPP_SENT
}

enum TrainingProgramType {
  TRAINING
  SEMINAR
}

enum RecruitmentPaymentStatus {
  PENDING
  VERIFIED
  FAILED
}

model Candidate {
  id String @id @default(cuid())

  // Personal Details
  fullName         String
  mobile           String
  whatsappNumber   String?
  email            String
  emailVerified    Boolean   @default(false)
  dob              DateTime?
  age              Int?
  gender           String?
  currentAddress   String?   @db.Text
  permanentAddress String?   @db.Text
  city             String
  state            String
  pinCode          String?

  // Education
  highestQualification   String?
  technicalQualification String?
  instituteName          String?
  yearOfPassing          Int?

  // Experience
  totalExperienceYears Float?
  currentEmployer      String?
  previousEmployers    String? @db.Text
  currentSalary        Int?
  expectedSalary       Int?
  noticePeriod         String?
  readyImmediate       Boolean @default(false)

  // Engagement Type (Associate Service Partner = COMMISSION, Full-Time Employee = SALARY)
  engagementType      PayoutMethod?
  finalCommissionRate Int?
  finalMonthlySalary  Int?

  // Position & Skills (form fields shown dynamically per position on the client)
  position            RecruitmentPosition
  skills              Json?
  equipmentExperience Json?
  workCapability      Json?

  // Driving
  twoWheelerAvailable  Boolean @default(false)
  fourWheelerDriving   Boolean @default(false)
  drivingLicenseNumber String?
  drivingLicenseUrl    String? @db.Text

  // Family
  fatherName         String?
  motherName         String?
  maritalStatus      String?
  spouseName         String?
  familyMembersCount Int?
  emergencyContact   String?

  // Bank (optional at initial stage)
  bankAccountName   String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?

  // Documents (Cloudinary URLs)
  aadhaarUrl            String? @db.Text
  panUrl                String? @db.Text
  resumeUrl             String? @db.Text
  photoUrl              String? @db.Text
  experienceCertUrls    Json?
  salarySlipUrl         String? @db.Text
  educationCertUrls     Json?
  policeVerificationUrl String? @db.Text
  vaccinationCertUrl    String? @db.Text
  videoIntroUrl         String? @db.Text

  // CRM / Pipeline
  status               CandidateStatus @default(NEW)
  rating               Int? // recruiter assessment, 1-10
  rejectionReason      String?         @db.Text
  interviewScheduledAt DateTime?
  interviewNotes       String?         @db.Text // interviewer name / location / free-text
  registrationId       String?         @unique // e.g. TECH-2026-00042, generated after payment
  convertedUserId      String?         @unique // set once promoted to a live ENGINEER User

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  convertedUser       User?                  @relation(fields: [convertedUserId], references: [id], onDelete: SetNull)
  notes               CandidateNote[]
  activities          CandidateActivityLog[]
  payments            RecruitmentPayment[]
  trainingAttendances TrainingAttendance[]

  @@index([status])
  @@index([position])
  @@index([city])
  @@index([state])
  @@index([mobile])
  @@index([createdAt])
}

model CandidateNote {
  id          String   @id @default(cuid())
  candidateId String
  authorId    String
  note        String   @db.Text
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateActivityLog {
  id          String                @id @default(cuid())
  candidateId String
  type        CandidateActivityType
  description String                @db.Text
  fromStatus  CandidateStatus?
  toStatus    CandidateStatus?
  performedBy String? // admin name, or "System"
  createdAt   DateTime              @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([type])
  @@index([createdAt])
}

model RecruitmentPayment {
  id                String                   @id @default(cuid())
  candidateId       String
  amount            Int // Rupees
  razorpayOrderId   String?                  @unique
  razorpayPaymentId String?                  @unique
  status            RecruitmentPaymentStatus @default(PENDING)
  createdAt         DateTime                 @default(now())
  verifiedAt        DateTime?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([status])
}

model TrainingProgram {
  id           String              @id @default(cuid())
  title        String
  description  String?             @db.Text
  type         TrainingProgramType @default(TRAINING)
  scheduledAt  DateTime
  seatLimit    Int?
  materialUrls Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  attendances TrainingAttendance[]

  @@index([scheduledAt])
  @@index([type])
}

model TrainingAttendance {
  id                String   @id @default(cuid())
  trainingProgramId String
  candidateId       String?
  engineerUserId    String?
  attended          Boolean  @default(false)
  certificateUrl    String?  @db.Text
  createdAt         DateTime @default(now())

  trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  candidate       Candidate?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  engineerUser    User?           @relation(fields: [engineerUserId], references: [id], onDelete: SetNull)

  @@index([trainingProgramId])
  @@index([candidateId])
  @@index([engineerUserId])
}
